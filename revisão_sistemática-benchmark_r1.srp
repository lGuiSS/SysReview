    {
      "id": "scopus_586",
      "title": "Experimental study and finite element analysis on residual carrying capacity of CLT wall-floor angle bracket connections after fire",
      "authors": "Xing, Zhiyan and Zhang, Jin and Zheng, Chengyu and Lu, Chuan",
      "affiliations": "Key Laboratory of Concrete and Prestressed Concrete Structures, Ministry of Education, Nanjing, Jiangsu, China; Southeast University, School of Civil Engineering, Nanjing, Jiangsu, China; Zhenro Properties Group Limited, Shanghai, China; China Resources Land (Nanchang) Limited, Nanchang, China",
      "countries": [
        "China"
      ],
      "journal": "Construction and Building Materials",
      "year": 2022,
      "score": 39,
      "abstract": "Fire resistance and residual carrying capacity of cross-laminated timber (CLT) structure are key considerations in multi-story and high-rise buildings. These aspects were studied for CLT wall-floor angle bracket connections using 60 and 80 mm self-tapping screws. Ten connections were tested for static loading at ambient temperature and residual post-fire carrying capacity, giving temperature–time, carbonization and load–displacement values. A finite element model of the connections produces a constitutive relationship for wood transverse-grain compression densification, and nonlinear spring element is used to simulate the failure mode of screw. Findings include that longer screws improve post-fire connection performance but reduce ductility and increase brittleness. This provides a reference for design of fire-resistant CLT connections. © 2022 Elsevier Ltd",
      "keywords": [
        "Angle bracket connection",
        "Cross-laminated timber",
        "Finite element",
        "Fire resistance"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1016/j.conbuildmat.2022.127113",
      "language": "English",
      "source": "Scopus",
