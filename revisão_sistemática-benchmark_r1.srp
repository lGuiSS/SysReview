        {
          "id": "web_of_science_1958",
          "title": "State of the art of the effective flange width for composite T-beams",
          "authors": "Masoudnia, Reza",
          "affiliations": "Western Sydney University",
          "countries": [],
          "journal": "CONSTRUCTION AND BUILDING MATERIALS",
          "year": 2020,
          "score": 5,
          "abstract": "Composite T-beams represent an efficient and economical structural beam element for a wide range of structural applications. A T-beam subjected to a positive bending moment results in part of the slab acting as the flange of the girder and resisting compression. When the spacing between the girders becomes large, shear-lag phenomena lead to compressive stresses in the flange that vary with the distance from the girder web and the flange area over the web becomes more highly stressed than the extremities. These phenomena lead to inaccurate structural analyses. Therefore, the effective flange width concept has been introduced for design purposes. (C) 2020 Elsevier Ltd. All rights reserved.",
          "keywords": [
            "Composite T-beam",
            "Simple beam theory",
            "Shear lag",
            "Effective flange width",
            "CLT"
          ],
          "studyType": "Review",
