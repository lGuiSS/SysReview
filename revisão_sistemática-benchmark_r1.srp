        {
          "id": "scopus_209",
          "title": "Development of an Innovative Composite Steel and Cross Laminated Timber Floor System",
          "authors": "Hicks, Stephen James and Woodward, Andrew and Hamad, Waleed I.",
          "affiliations": "Faculty of Science, Engineering and Medicine, Coventry, West Midlands, United Kingdom; WSP Global Inc., Montreal, QC, Canada",
          "countries": [
            "United Kingdom",
            "Canada"
          ],
          "journal": "IABSE Symposium Tokyo 2025: Environmentally Friendly Technologies and Structures: Focusing on Sustainable Approaches - Report",
          "year": 2025,
          "score": 20,
          "abstract": "This paper presents the results from a major research programme that investigated an innovative composite steel and cross laminated timber (CLT) floor system for low-, medium- and high-rise office developments. In total, 21 push tests were completed to investigate the effect of several key variables on the load-slip behaviour of the shear connectors, including the stud spacing, gap between the CLT panels, and the transverse reinforcement bars. Based on the optimum shear connector arrangement determined from the push tests, a 12.0 m composite steel and CLT beam has been constructed at full-scale and will be load tested to failure at the University of Warwick. The tests demonstrate that the shear connectors easily satisfied the Eurocode 4 requirements for 'ductile' connectors, which permits the use of partial shear connection theory to be applied in design using this technology. © 2025 IABSE Symposium Tokyo 2025: Environmentally Friendly Technologies and Structures: Focusing on Sustainable Approaches - Report All rights reserved.",
          "keywords": [
            "Composite steel and CLT floor",
            "Eurocode 4",
            "mass timber",
            "push tests",
            "SDG 11",
            "SDG 13",
            "SDG 9",
            "shear studs",
            "Sustainable Development Goal (SDG)"
          ],
