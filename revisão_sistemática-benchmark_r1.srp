    {
      "id": "scopus_899",
      "title": "Full-Scale Shake Table Testing of Cross-Laminated Timber Rocking Shear Walls with Replaceable Components",
      "authors": "Blomgren, Hans Erik and Pei, Shiling and Jin, Zhibin and Powers, Josh and Dolan, James Daniel and van de Lindt, John W. and Barbosa, Andre R. and Huang, Da",
      "affiliations": "Testing and Characterization, Seattle, WA, United States; Colorado School of Mines, Department of Civil & Environmental Engineering, Golden, CO, United States; Southwest Jiaotong University, Department of Bridge Engineering, Chengdu, Sichuan, China; Katerra, Seattle, WA, United States; Voiland College of Engineering and Architecture, Pullman, WA, United States; Walter Scott, Jr. College of Engineering, Fort Collins, CO, United States; College of Engineering, Corvallis, OR, United States",
      "countries": [
        "United States",
        "China"
      ],
      "journal": "Journal of Structural Engineering (United States)",
      "year": 2019,
      "score": 13,
      "abstract": "To investigate and validate the seismic performance of a new cross-laminated timber rocking shear wall lateral system, a series of shake table tests were conducted on a full-scale, two-story, mass timber building at the NHERI@UCSD outdoor shake table facility. The prototype wall system was designed to remain damage-free during frequent service level earthquakes and repairable after larger events [design basis earthquakes (DBEs) and maximum considered earthquakes (MCEs)] while utilizing replaceable components that enable quick repair after a large earthquake. The test building was subjected to a series of 13 earthquake ground motions and reached a maximum roof drift of 3.85%. Following shake table tests at the DBE and MCE levels, the building was inspected and repaired by replacing the damaged energy absorbing components. The test data demonstrated that the proposed system was able to achieve the desired seismic performance (i.e., repairable) and also effectively control building deformation under code-specified levels at DBE- and MCE-level events. © 2019 American Society of Civil Engineers.",
      "keywords": [
        "Laminating",
        "Seismic waves",
        "Shear walls",
        "Timber",
        "Wooden buildings",
        "Absorbing components",
        "Building deformations",
        "Earthquake ground motions",
        "Large earthquakes",
        "Maximum considered earthquakes",
        "Seismic Performance",
        "Shake table testing",
        "Shake table tests",
        "Earthquakes"
      ],
      "studyType": "Article",
      "quality": null,
