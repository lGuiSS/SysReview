    {
      "id": "web_of_science_1480",
      "title": "Investigation of vibration behaviour of floors made of Cross Laminated Timber (CLT)",
      "authors": "Bogensperger, T. and Fitz, M. and Hamm, P. and Schickhofer, G.",
      "affiliations": "Graz University of Technology; Technical University of Munich",
      "countries": [],
      "journal": "BAUINGENIEUR",
      "year": 2010,
      "score": 14,
      "abstract": "The national and international standards require verifications of vibrations of timber floors due to human excitation. The suggested verifications do not exactly define the verification procedure but recommend ``special investigations''",
      "keywords": [],
      "studyType": "Article",
      "quality": null,
      "doi": null,
      "language": "German",
      "source": "Web of Science",
      "numString": 3,
