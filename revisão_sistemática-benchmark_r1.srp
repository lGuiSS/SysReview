    {
      "id": "scopus_761",
      "title": "FInite element modelling and parametric analysis of cross-laminated timber (CLT) shear walls in different construction configurations",
      "authors": "Wang, Xijun and He, Minjuan and Li, Zheng",
      "affiliations": "Tongji University, Shanghai, China",
      "countries": [
        "China"
      ],
      "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
      "year": 2021,
      "score": 45,
      "abstract": "As an innovative wood product, cross laminated timber (CLT) is widely used in the manufacture of prefabricated wall and floor panels. It can provide a prospective solution to mid-rise or high-rise timber structures. This paper presents finite element (FE) modelling and a parametric analysis on the lateral performance of cross-laminated timber (CLT) shear walls with different construction methods (i.e., platform and balloon construction methods). Nonlinear finite element models were respectively developed for platform-type and balloon-type CLT shear walls. Verified by the experimental results, the proposed models were further used in the parametric analysis to investigate the influence of vertical loads, metal connectors (i.e., hold-downs and angle brackets) and width-to-height ratios (b:h ratios) on the lateral performance of platform-type and balloon-type CLT shear walls. © WCTE 2021. All rights reserved.",
      "keywords": [
        "CLT shear walls",
        "Construction methods",
        "Lateral performance",
        "Numerical modelling",
        "Parametric analysis"
      ],
