          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:36:58.111Z",
          "lastModified": "2026-02-23T22:36:58.111Z"
        },
        {
          "id": "scopus_841",
          "title": "Environmental and economic evaluation of small-scale bridge repair using cross-laminated timber floor slabs",
          "authors": "Iwase, Tetsuya and Sasaki, Takanobu and Araki, Shogo and Huzita, Tomohumi and Kayo, Chihiro",
          "affiliations": "Tokyo University of Agriculture and Technology, Fuchu, Tokyo, Japan; Hokkaido University, Research Faculty of Agriculture, Sapporo, Hokkaido, Japan; Ltd., Shizuoka, Shizuoka, Japan; United Graduate School of Agricultural Science Tokyo University of Agriculture and Technology, Fuchu, Tokyo, Japan; Tokyo University of Agriculture and Technology, Fuchu, Tokyo, Japan",
          "countries": [
            "Japan"
          ],
          "journal": "Sustainability (Switzerland)",
          "year": 2020,
          "score": 39,
          "abstract": "Cross-laminated timber (CLT) has gained popularity worldwide in recent years, and its use in buildings and civil engineering structures has attracted attention in Japan. In this study, the life-cycle greenhouse gas (GHG) balance and costs associated with CLT floor slabs were evaluated with respect to small-scale bridge repair as the first instance of the use of CLT in civil engineering projects in Japan. Additionally, waterproofing treatment was applied to CLT slabs, and the potential GHG and cost reduction of CLT in comparison with reinforced concrete (RC) slabs were examined. GHG emissions were the smallest for non-waterproofed CLT slabs and the greatest for RC slabs. When replacing RC slabs with CLT slabs without waterproofing, fossil-derived GHG emissions can be reduced by 73 kg-CO<inf>2</inf>eq/m<sup>2</sup> per slab, and fossil/wood-derived GHG emissions can be reduced by 67 kg-CO<inf>2</inf>eq/m<sup>2</sup>; however, the use of disposed CLT as fuel is essential. Moreover, a reduction in GHG emissions can be expected if RC slabs are replaced with CLT slabs that are waterproofed only once every 20 years. Further, the cost associated with RC slabs is 20% of that attributable to CLT slabs. Hence, measures need to be taken to reduce the cost of CLT and waterproofing materials. © 2020 by the authors.",
          "keywords": [
            "Cross-laminated timber",
            "Floor slabs",
            "Greenhouse gas emissions",
            "Life-cycle assessment",
            "Reinforced concrete",
            "Waterproofing treatment"
          ],
          "studyType": "Article",
          "quality": null,
          "doi": "10.3390/SU12083424",
          "language": "English",
          "source": "Scopus",
          "numString": 2,
          "isDuplicate": false,
          "duplicateOf": null,
          "dataProcessingStatus": "pending",
          "filter1Status": "pending",
          "filter2Status": "pending",
          "filter3Status": "pending",
          "exclusionReason": null,
          "inclusionCriterion": null,
          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:36:58.111Z",
