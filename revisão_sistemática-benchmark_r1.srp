    {
      "id": "web_of_science_1618",
      "title": "Design exploration of robotically assembled cross-laminated timber houses with sequential path planning",
      "authors": "Zargar, Seyed Hossein and Duarte, Jose Pinto and Brown, Nathan C.",
      "affiliations": "Pennsylvania Commonwealth System of Higher Education (PCSHE); Pennsylvania State University; Pennsylvania State University - University Park; Pennsylvania Commonwealth System of Higher Education (PCSHE); Pennsylvania State University; Pennsylvania State University - University Park",
      "countries": [],
      "journal": "AUTOMATION IN CONSTRUCTION",
      "year": 2026,
      "score": 16,
      "abstract": "Robotic construction technologies, which require computational coordination, offer new opportunities to develop quantitative assessments of constructability for early design exploration. This paper demonstrates an approach to extracting simplified constructability metrics during sequential path planning for building construction with a mobile robotic arm. The approach is used to explore a design space for a Cross-Laminated Timber (CLT) panel house. Constructability is assessed through robot travel time, robot viability ratings, assembly steps requiring temporary shoring, and panel waste. The robot viability ratings are created by predefining wall and roof panel assembly scenarios, which are assigned difficulty weights using full path planning simulations. Sequential path planning and stability analyses are then conducted to count the weighted scenarios and instances requiring temporary supports for the design. The scenario counts in the assembly sequences are then aggregated into overall viability ratings for each design, enabling comparative assessments across the design space.",
      "keywords": [
        "Human-robot collaborative construction",
        "Robotic constructability assessment",
        "Data-driven design",
        "Multi-objective optimization",
        "Design space exploration"
      ],
