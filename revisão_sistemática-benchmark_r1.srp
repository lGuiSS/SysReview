        {
          "id": "scopus_1026",
          "title": "Fire resistance of unprotected cross-laminated timber wall and floor assemblies made in the USA",
          "authors": "Muszyñski, Lech and Gupta, Rakesh and Hong, Seung-hyun and Osborn, Neil and Pickett, Brent",
          "affiliations": "Oregon State University, Department of Wood Science and Engineering, Corvallis, OR, United States; Western Fire Center, Inc., WA, United States",
          "countries": [
            "United States"
          ],
          "journal": "WCTE 2018 - World Conference on Timber Engineering",
          "year": 2018,
          "score": 14,
          "abstract": "Fire concerns are one reason for building code restrictions against tall wood buildings in US. Despite growing body of empirical data on fire performance of cross-laminated timber (CLT) generated in Europe, Japan and Canada, lack of full-scale tests performed on structural CLT",
