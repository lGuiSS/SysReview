        },
        {
          "id": "scopus_751",
          "title": "Dynamic amplification factor for peak roof acceleration on lateral systems based on post-tensioned cross-laminated timber rocking walls",
          "authors": "Acuña, Gustavo and Dolan, James Daniel and Motter, Christopher J.",
          "affiliations": "Washington State University Pullman, Pullman, WA, United States",
          "countries": [
            "United States"
          ],
          "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
          "year": 2021,
          "score": 12,
          "abstract": "The interest in Cross-Laminated Timber as an alternative for buildings in high seismic zones leads to a continuous search for innovation and solutions to optimize the design. For mid- and high-rise structural systems with lateral rocking-base mechanism, research has shown that their dynamic response is highly influenced by higher-mode effects. To quantify that effect, a parametric study was carried out in this work. The dynamic amplification factor for the peak roof acceleration was studied through non-linear time-history analyses for a set of different wall configurations. It was determined that for 6-story buildings the best structural system is base-rocking only, and for 10-story structures it is best to introduce a second rocking joint using the transfer beam mechanism. It was also determined that the stiffness of the transfer beam influences the acceleration, displacement, and moment distribution, therefore it is a variable that must be accounted for in the design phase. Lastly, the variation in the response due to the presence (or rather absence) of dissipator devices was studied, resulting in improved performance when the dissipators were considered in the analyses. © WCTE 2021. All rights reserved.",
          "keywords": [
            "Cross-Laminated Timber",
            "Higher-mode effects",
            "Multiple rocking joints",
            "Peak floor acceleration"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": null,
          "language": "English",
