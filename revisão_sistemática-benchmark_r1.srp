          "inclusionCriterion": null,
          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:36:58.096Z",
          "lastModified": "2026-02-23T22:36:58.096Z"
        },
        {
          "id": "scopus_750",
          "title": "Seismic isolated CLT building",
          "authors": "Dechent, Peter and Zilic, Frane and Dolan, Daniel and Riveros, Diego and Giuliano, Gian Carlo and Ávila, Francisco",
          "affiliations": "Universidad de Concepcion, Concepcion, BI, Chile; Washington State University Pullman, Pullman, WA, United States; Ingeniería e Inv. Ltda., G&D Arquitectura, Concepcin, Chile",
          "countries": [
            "Chile",
            "United States"
          ],
          "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
          "year": 2021,
          "score": 10,
          "abstract": "This paper presents the results of an research intended to elaborate in Chile the construction bases of an eight story building structured with Chilean Radiata Pine CLT walls and slabs. The building is to be built with seismic isolation, which on the other hand increases architectural freedom by reducing the seismic demand. The conventional seismic design (with fix base) for unincorporated materials (CLT) requires a reduction factor of R=2, which limits the amount of stories that can be built. Due to the lack of design experience that Chile has for this type of structures, it is necessary to use international standards and documentation complementary to the Chilean codes. Due to low structural weight, additional mass is necessary to generate resistance for wind forces and to overcome the overturning forces due to earthquakes. This additional mass is reached by increasing the concrete topping slab volume over the isolation system. The design in this type of structures is controlled mainly by the connectors between the structural elements, i.e. tensors, metal plates or screws. Two design alternatives were analyzed, platform system and balloon system, the latter being chosen because it achieved a reduction of the number of connectors, hence reducing the costs. © WCTE 2021. All rights reserved.",
          "keywords": [
            "CLT",
            "Connectors",
            "Seismic isolation"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": null,
          "language": "English",
