    {
      "id": "scopus_1057",
      "title": "Predicting effects of design variables on modal responses of CLT floors",
      "authors": "Ussher, Ebenezer and Arjomandi, Kaveh and Weckendorf, Jan and Smith, Ian",
      "affiliations": "University of New Brunswick, Faculty of Forestry and Environmental Management, Fredericton, NB, Canada; University of New Brunswick, Department of Civil Engineering, Fredericton, NB, Canada; University of New Brunswick, Fredericton, NB, Canada",
      "countries": [
        "Canada"
      ],
      "journal": "Structures",
      "year": 2017,
      "score": 29,
      "abstract": "New ultralight materials like cross-laminated-timber (CLT) enable attainment of longer floor spans than are possible with traditional shallow-profile timber construction. Their low modal mass to stiffness ratios make ensuring satisfactory dynamic responses under normal building occupancy conditions a primary design consideration. This paper presents numerical techniques for accurate prediction of modal frequencies, which are essential input to contemporary floor vibration serviceability design criteria. Recommendations are made for minimum requirements for design level prediction of modal responses of CLT floors, based on numerical and experimental studies of effects engineering design variables have on such characteristics. © 2017 Institution of Structural Engineers",
      "keywords": [
        "Cross-laminated-timber",
        "Finite element analysis",
        "Floor vibration",
        "Modal analysis",
        "Timber structures"
      ],
      "studyType": "Article",
