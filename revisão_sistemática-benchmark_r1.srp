    {
      "id": "scopus_2108",
      "title": "Failure behavior of composite laminates under out-of-plane loads",
      "authors": "Koc, Murat and Sönmez, Fazil Önder and Ersoy, Nuri B.",
      "affiliations": "Yıldız Teknik Üniversitesi, Istanbul, Turkey; Boğaziçi Üniversitesi, Department of Mechanical Engineering, Bebek, Istanbul, Turkey",
      "countries": [
        "Turkey"
      ],
      "journal": "ECCM 2012 - Composites at Venice, Proceedings of the 15th European Conference on Composite Materials",
      "year": 2012,
      "score": 19,
      "abstract": "In this study, failure behavior of fiber-reinforced composites under out-of-plane loads is investigated. For this purpose, four-point bending tests are simulated using both Classical Lamination Theory (CLT) and Finite Element Method (FEM) with brick elements. Unidirectional [θ<inf>6</inf>] <inf>s</inf> and balanced symmetric [θ<inf>3</inf>/-θ<inf>3</inf>] <inf>s</inf> composite laminates are considered and maximum allowable moment resultants as a function of fiber orientation angle, θ, are obtained using different failure criteria. The differences between the model predictions are discussed.",
      "keywords": [
        "Bending",
        "Composite materials",
        "Failure criteria",
        "Finite element method"
      ],
