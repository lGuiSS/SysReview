        {
          "id": "scopus_402",
          "title": "Theoretical, numerical and experimental studies on thermal insulation performance of different cross laminated timber walls",
          "authors": "Ye, Qi and Gong, Yingcliun Chun and Ren, Haiqing and Peng, Lin and Zhang, Houjiang",
          "affiliations": "Chinese Academy of Forestry, Beijing, China; Jiangsu Co-Innovation Center of Efficient Processing and Utilization of Forest Resources, Nanjing, Jiangsu, China; Beijing Forestry University, School of Technology, Beijing, Beijing, China",
          "countries": [
