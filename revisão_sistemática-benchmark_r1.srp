        {
          "id": "scopus_2055",
          "title": "Theoretical modelling and experimental characterization of composite material for ulna bone plate application",
          "authors": "Deshmukh, Rajkumar and Sanap, Sudarshan B. and Thakur, Dineshsingh G.",
          "affiliations": "MIT Art, Design and Technology University, Department of Mechanical Engineering, Pune, MH, India",
