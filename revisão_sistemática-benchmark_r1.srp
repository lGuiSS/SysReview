        {
          "id": "web_of_science_1628",
          "title": "Prediction of shear properties in cross laminated timber-concrete composites with notch connections",
          "authors": "Jeong, Gi Young and Pham, Van Sy and Tran, Dangkhai",
          "affiliations": "Chonnam National University",
          "countries": [],
          "journal": "STRUCTURES",
          "year": 2025,
          "score": 15,
          "abstract": "This study develops an equation to predict the shear capacity of cross-laminated timber (CLT)-concrete composites (CCC) with notch connections. The equation accounts for key variables, including wood species, notch depth, and load-to-grain direction. To assess the impact of these factors, push-out tests were conducted to evaluate the slip modulus and shear capacity of CCC. The results showed that the larch CLT notch connector exhibited a 14.70 \\% higher slip modulus and a 21.78 \\% higher shear capacity than the pine CLT. While the slip modulus remained relatively unchanged with increasing notch depth, the shear capacity increased by 9.39 \\%, 37.97 \\%, and 67.20 \\% for notch depths of 30, 40, and 50 mm, respectively, compared to the 20-mm notch depth. Additionally, CLTs with notch depths of 20 and 40 mm demonstrated higher slip moduli and shear capacities when loaded in the 0 degrees load-to-grain direction compared to the 90 degrees direction. A new prediction equation for shear properties in CCC with notch connections is proposed, incorporating the effects of wood density, notch depth, and CLT panel thickness. The difference between experimental and predicted values for slip modulus and shear capacity ranged from 0.04 \\% to 12.00 \\% and 2.25-20.00 \\%, respectively.",
          "keywords": [
            "Slip modulus",
            "Shear capacity",
            "CLT floor",
            "Wood species",
            "Load-to-grain direction",
            "Notch connection"
          ],
          "studyType": "Article",
          "quality": null,
          "doi": "10.1016/j.istruc.2025.108949",
          "language": "English",
