          "inclusionCriterion": null,
          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:36:58.004Z",
          "lastModified": "2026-02-23T22:36:58.004Z"
        },
        {
          "id": "scopus_140",
          "title": "ADHESIVELY BONDED AND HYBRID CLT PANEL-TO-PANEL JOINTS",
          "authors": "Pace, Alicja and Ganjali, Houman and Zhang, Lei and Mpidi Bita, Hercend and Tannert, Thomas",
          "affiliations": "University of Northern British Columbia, School of Engineering, Prince George, BC, Canada; Timber Engineering Inc., Vancouver, BC, Canada",
          "countries": [
            "Canada"
          ],
          "journal": "Proceedings from the 14th World Conference on Timber Engineering: Advancing Timber for the Future Built Environment, WCTE 2025",
          "year": 2025,
          "score": 16,
          "abstract": "Cross-laminated timber (CLT) panels are increasingly being used in floor construction with the individual panels often connected with self-tapping screws (STS) through surface spline, half-lap, and butt joints. An alternative solution is provided by using the TS3 technology which connects butt joints through adhesives and creates a near-rigid connection, enabling the utilization of the two-way resistance of CLT panels. However, TS3 joints fail in a brittle manner. To address this issue, in this study, the mechanical properties of screw, TS3, and hybrid TS3-screw connections between CLT in the major and minor strength directions were investigated using out-of-plane 3-point and 4-point bending tests. The tests showed brittle failure for TS3 joints and ductile failure for STS joints, while the hybrid joints had similar stiffness as the TS3 joints. © (2025) WORLD CONFERENCE ON TIMBER ENGINEERING 2025 (WCTE 2025) All rights reserved.",
          "keywords": [
            "cross-laminated timber",
            "rotational stiffness",
            "self-tapping screws",
            "spline connection"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": "10.52202/080513-0473",
          "language": "English",
          "source": "Scopus",
          "numString": 2,
          "isDuplicate": false,
          "duplicateOf": null,
          "dataProcessingStatus": "pending",
          "filter1Status": "pending",
          "filter2Status": "pending",
          "filter3Status": "pending",
          "exclusionReason": null,
          "inclusionCriterion": null,
          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
