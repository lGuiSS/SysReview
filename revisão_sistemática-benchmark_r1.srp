    {
      "id": "scopus_489",
      "title": "AN ACCURATE FINITE ELEMENT MODEL TO STUDY THE PROGRESSIVE COLLAPSE OF POST-AND-BEAM MASS TIMBER BUILDINGS",
      "authors": "Lyu, Chunhao and Gilbert, Benoit P. and Guan, Hong and Karampour, Hassan and Gunalan, Shanmuganathan and Leggate, William",
      "affiliations": "Griffith University, Brisbane, QLD, Australia",
      "countries": [
        "Australia"
      ],
      "journal": "13th World Conference on Timber Engineering, WCTE 2023",
      "year": 2023,
      "score": 29,
      "abstract": "The structural behaviour of mass timber buildings under the removal of a load bearing element is complex. To well understand this phenomenon and ultimately develop scientifically based design guidelines against progressive collapse for this type of buildings, there is a need to develop Finite Element models which accurately capture the nonlinear structural responses of such buildings. This paper presents how mass timber post-and-beam systems can be accurately modelled using Finite Element under edge and corner column removal scenarios. The model was validated against published 3D experimental tests performed on scaled-down substructures. Results show that the model accurately replicated non-linear behaviour, load redistribution mechanisms, ultimate loads, failure modes, and strain developments. The use of the model was then illustrated by running parametric studies to quantify (i) the influence of the Cross Laminated Timber (CLT) floor panels layout and (ii) one alternative load path, typically ignored in design, on the progressive collapse resistance capacity. © 13th World Conference on Timber Engineering, WCTE 2023. All rights reserved.",
      "keywords": [
        "Disproportionate collapse",
        "Finite element",
        "Floor CLT panels layout",
        "Mass timber post-and-beam buildings",
        "Numerical simulations",
        "Progressive collapse"
      ],
      "studyType": "Conference paper",
      "quality": null,
      "doi": "10.52202/069179-0368",
