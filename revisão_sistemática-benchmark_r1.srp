        {
          "id": "scopus_510",
          "title": "DETERMINATION OF THE EFFECTIVE WIDTH OF CROSS-LAMINATED TIMBER RIB PANELS USING DIGITAL IMAGE CORRELATION",
          "authors": "Kleinhenz, Miriam and Viertel, Martin and Demschner, Thomas and Frangi, Andrea",
          "affiliations": "ETH Zürich, Institute of Structural Engineering, Zurich, ZH, Switzerland; ETH Zürich, Institute of Structural Engineering, Zurich, ZH, Switzerland; Stora Enso Wood Products GmbH, Brand, Austria; ETH Zürich, Institute of Structural Engineering, Zurich, ZH, Switzerland",
          "countries": [
            "Switzerland",
            "Austria"
          ],
          "journal": "13th World Conference on Timber Engineering, WCTE 2023",
          "year": 2023,
          "score": 14,
          "abstract": "The effective width of cross-laminated timber rib panels is analysed. The floor system consists of cross-laminated timber plates rigidly bonded to glued-laminated timber ribs by means of screw-press gluing. Ultimate-load tests were performed on four different cross-sections. Digital image correlation was used to visualize and monitor the strain distribution on top of the cross-laminated timber plates at midspan. The longitudinal strain distributions along the cross-laminated timber width were obtained for the determination of the effective width. The experimental results are compared to numerical results of a finite element model and to Eurocode 5 estimations. The longitudinal strain distributions show good agreement and confirm digital image correlation as a suitable measurement technique. © WCTE 2023.All rights reserved",
          "keywords": [
            "cross-laminated timber",
            "effective width",
            "finite-element modelling",
            "Massive timber rib panel",
            "optical measurement technique",
            "strain distribution"
          ],
