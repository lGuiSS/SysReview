        },
        {
          "id": "scopus_757",
          "title": "Comparative analysis of the feasibility of hollowcore mass timber panels for long span floor systems",
          "authors": "Hull, Tyler and Lacroix, Daniel N.",
          "affiliations": "University of Waterloo, Department of Civil & Environmental Engineering, Waterloo, ON, Canada",
          "countries": [
            "Canada"
          ],
          "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
          "year": 2021,
          "score": 23,
          "abstract": "Mass timber products have allowed the adoption of wood building products in structures typically reserved for concrete and steel. However, in larger, open floor plan buildings adoption of wood products have been hindered by vibration concerns limiting the attainable floor spans. A composite hollowcore mass timber (HMT) panel offers a potential solution. A comparative analysis is performed between an HMT panel floor system and a conventional beam and purlin floor system, designed to span an 11m column grid, to assess the feasibility of the HMT panels as an industry viable long span floor system. A numerical model, validated against existing CLT-glulam T-beam experimental data, and two code adopted analytical methods was used to determine the effective bending stiffness of the HMT panel. Analysis showed that a 514mm deep HMT panel was able to achieve a vibration-controlled span of 11.1m. The HMT panel was 275mm shallower than the other system resulting in more space to run services and reducing the amount of “beam shadowing”. However, the volume of wood required was 18% more, which should also be considered in costing. Overall, the HMT panel showed it had tremendous potential as an industry viable long span floor system able to efficiently achieve spans beyond those of current mass timber slab products. © WCTE 2021. All rights reserved.",
          "keywords": [
            "CLT",
            "Floor system",
            "Glulam",
            "Hollowcore mass timber",
            "Long span",
            "Numerical analysis",
            "Vibration"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": null,
          "language": "English",
