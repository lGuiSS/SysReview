        {
          "id": "web_of_science_1648",
          "title": "Laterally loaded behaviour of connections in timber-timber composite (TTC) floor system: An experimental and analytical investigation",
          "authors": "Yin, Tianxiao and Wang, Yi and Sun, Chuang and Wang, Zhiqiang and Reynolds, Thomas P. S.",
          "affiliations": "Nanjing Forestry University; University of Edinburgh",
          "countries": [],
          "journal": "ENGINEERING STRUCTURES",
          "year": 2025,
          "score": 10,
          "abstract": "Timber-timber composite (TTC) floor systems are potentially an efficient system for longer floor spans than are possible with solid wood joists or mass timber slabs. The connections in TTC are vital to the mechanical performance of the whole structure. The mechanical properties of connections in a TTC system combining with hybrid cross-laminated timber (HCLT) and either laminated veneer lumber (LVL) or bamboo scrimber are investigated in this study through experimental and analytical methods. The basic properties of such timber products with self-tapping screw (STS), embedment strength, withdrawal and head pull-through capacity, together with the laterally loaded shear properties of joints, were assessed by experimental investigation. A modified ``rope effect''",
          "keywords": [
            "Timber-timber composite",
            "Connection",
            "Hybrid cross-laminated timber",
            "Bamboo",
            "Rope effect"
          ],
