        {
          "id": "web_of_science_1926",
          "title": "Self-tensioning long-span T-shaped spruce and oak web floors with a CLT upper flange. An experimental approach",
          "authors": "Martin-Gutierrez, E. and Estevez-Cimadevila, J. and Otero-Chans, D. and Suarez-Riestra, F.",
