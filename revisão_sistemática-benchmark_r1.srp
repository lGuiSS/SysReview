    {
      "id": "scopus_868",
      "title": "Fundamental study on walking vibration of cross laminated timber floor with finishing joist floor",
      "authors": "Koyama, Yuhei and Ohashi, Yoshinori and Fukuda, Shintaroh and Yokoyama, Yutaka",
      "affiliations": "Institute of Science Tokyo, Department of Architecture and Building Engineering, Tokyo, Japan; Hokkaido Research Organization, Forestry Research Institute, Sapporo, Hokkaido, Japan; Institute of Science Tokyo, Department of Architecture and Building Engineering, Tokyo, Japan; Institute of Science Tokyo, Department of Architecture and Building Engineering, Tokyo, Japan",
      "countries": [
        "Japan"
      ],
      "journal": "Journal of Environmental Engineering (Japan)",
      "year": 2020,
      "score": 75,
      "abstract": "Walking vibration can cause complaints to building users on building floor, especially on timber floor. However, the estimation method of walking vibration is still not established. Following the previous study, to reveal the influence of finishing joist floor on walking vibration, CLT floors made of two kinds of materials with joist floor were investigated in this study. At first, vibration characteristics of the CLT floors without joist floor and with joist floor subjected to walking vibrations was measured. Then, four finite element models were also created and analysis methods to reproduce the measured results were obtained. © 2020 Architectural Institute of Japan. All rights reserved.",
      "keywords": [
        "Cross laminated timber floor",
        "Finishing joist floor",
        "Finite element method",
        "Habitability",
        "Half lapped joint",
        "Walking vibration"
      ],
