          ],
          "studyType": "Article",
          "quality": null,
          "doi": "10.1061/(ASCE)ST.1943-541X.0002382",
          "language": "English",
          "source": "Scopus",
          "numString": 2,
          "isDuplicate": false,
          "duplicateOf": null,
          "dataProcessingStatus": "pending",
          "filter1Status": "pending",
          "filter2Status": "pending",
