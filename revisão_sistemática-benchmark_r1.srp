    {
      "id": "web_of_science_1509",
      "title": "Behaviour of cross-laminated timber wall systems under monotonic lateral loading",
      "authors": "Hughes, C. and McPolin, D. and McGetrick, P. and McCrum, D.",
      "affiliations": "Queens University Belfast; University College Dublin",
      "countries": [],
      "journal": "JOURNAL OF STRUCTURAL INTEGRITY AND MAINTENANCE",
      "year": 2019,
      "score": 50,
      "abstract": "In response to the global drive towards sustainable construction, CLT has emerged as a competitive alternative to other construction materials. Despite the construction of CLT buildings up to 10 storeys in areas of low seismicity, few multi-storey CLT buildings have been constructed in areas of moderate to high seismicity due to lack of knowledge regarding their performance under lateral loading. Previous experimental studies of the behaviour of CLT wall systems under lateral loading have been limited to replicating the conditions within multi-storey buildings with approximately three storeys, and most wall systems tested replicated ground floor wall systems. To develop an understanding of how taller CLT buildings would behave under lateral loading, for the first time, testing of a CLT wall system replicating conditions within buildings taller than three storeys was undertaken. A wall system representative of above ground floor wall systems within a 10 storey CLT building was experimentally tested; the wall system was subjected to monotonic lateral load and constant vertical load, with vertical loads replicating gravity loads at storeys within a 10 storey CLT building. The results obtained suggest variable behaviour of wall systems throughout multi-storey CLT buildings, with lateral movement becoming significant at higher storeys.",
      "keywords": [
        "Cross-laminated timber",
        "wall systems",
        "tall building",
        "lateral load"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1080/24705314.2019.1622187",
      "language": "English",
      "source": "Web of Science",
      "numString": 3,
      "isDuplicate": true,
      "duplicateOf": "scopus_912",
