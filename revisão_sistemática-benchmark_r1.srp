    {
      "id": "scopus_137",
      "title": "EXPERIMENTAL STUDY INTO MECHANICAL PROPERTIES OF A NOVEL MASS TIMBER T-BEAM SYSTEM",
      "authors": "Ayodele, Ayomide D. and Clouston, Peggi L. and Slivets, Evgenii and Musah, Munkaila",
      "affiliations": "University of Massachusetts Amherst, Amherst, MA, United States",
      "countries": [
        "United States"
      ],
      "journal": "Proceedings from the 14th World Conference on Timber Engineering: Advancing Timber for the Future Built Environment, WCTE 2025",
      "year": 2025,
      "score": 29,
      "abstract": "This study investigates the bending stiffness and strength of a novel mass timber floor system in the form of 6-layer T-beams using North American Spruce-Pine-Fir (SPF). The T-beams were fabricated by the authors and tested in four-point bending. The results showed promising improvement in the efficiency of major axis properties when compared to conventional 3-layer CLTs and indicate structural viability of the new configuration. © (2025) WORLD CONFERENCE ON TIMBER ENGINEERING 2025 (WCTE 2025) All rights reserved.",
      "keywords": [
        "Cross-laminated timber (CLT)",
        "Mass timber",
