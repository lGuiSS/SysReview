    {
      "id": "web_of_science_1840",
      "title": "Structural development of a novel punctually supported timber building system for multi-storey construction",
      "authors": "Krtschil, Anna and Orozco, Luis and Bechert, Simon and Wagner, Hans Jakob and Amtsberg, Felix and Chen, Tzu-Ying and Shah, Anand and Menges, Achim and Knippers, Jan",
      "affiliations": "University of Stuttgart; University of Stuttgart",
      "countries": [],
      "journal": "JOURNAL OF BUILDING ENGINEERING",
      "year": 2022,
      "score": 9,
      "abstract": "Though capable of allowing multi-directional spans, timber products such as cross-laminated timber are primarily utilized uni-directionally using linear supports like walls or beam elements. Recent building designs increasingly show punctual supports but with narrow column grid lay-outs. Support beams and narrow grids limit the design space for multi-storey timber buildings. To overcome these design limits, an integrative design concept for punctually supported timber slabs is being developed that allows for large spans and irregular column layouts. Therefore, engineering methods are integrated in the architectural design of the building components, such as plates, columns, and their connections. The developed slab system combines hardwood and softwood materials in a sandwich construction. The plates have a tailored internal topology considering the force flow in the slab. A plate-to-plate connection design is evaluated through mechanical tests, which also serve as calibration for the global structural model. The research findings are validated through the design and construction of a large scale demonstrator: the ITECH Campus Lab.",
      "keywords": [
        "Timber connections",
        "Timber engineering",
        "Building design",
        "Computational design"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1016/j.jobe.2022.104972",
      "language": "English",
      "source": "Web of Science",
      "numString": 3,
      "isDuplicate": true,
      "duplicateOf": "scopus_556",
