          "id": "scopus_1118",
          "title": "A contribution to the design of ribbed plates",
          "authors": "Augustin, Manfred and Zimmer, Severin E. and Bogensperger, Thomas and Sleik, Tim",
          "affiliations": "holz.bau forschungs gmbh, Graz, Styria, Austria; Binderholz Bausysteme GmbH, Hallein, Austria",
          "countries": [
            "Austria"
          ],
