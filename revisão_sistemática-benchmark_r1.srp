        },
        {
          "id": "scopus_1142",
          "title": "Behavior of cross-laminated timber diaphragm panel-to-panel connections with self-tapping screws",
          "authors": "Sullivan, Kyle and Miller, Thomas H. and Gupta, Rakesh",
          "affiliations": "Oregon State University, Dept, Corvallis, OR, United States; Oregon State University, Department of Civil Engineering, Corvallis, OR, United States; Oregon State University, Department of Wood Science and Engineering, Corvallis, OR, United States",
          "countries": [
            "United States"
          ],
          "journal": "WCTE 2016 - World Conference on Timber Engineering",
          "year": 2016,
          "score": 14,
          "abstract": "The goal of this project is to contribute to the development of design methods for cross-laminated timber (CLT) diaphragms in the seismic load resisting system for buildings. The 2.44 m (8 ft) long connections of this study are close to the length of full-scale joints in use. Using monotonic and cyclic tests, this study will determine strengths, stiffnesses, and ductility/energy dissipation of common self-tapping screw shear connections. Understanding how CLT floor diaphragm connections transfer lateral loads will aid in developing design provisions in the National Design Specification for Wood Construction and the International Building Code so structural engineers can more confidently use CLT in designing lateral-force-resisting systems.",
          "keywords": [
            "CLT",
            "Diaphragms",
            "Seismic design",
            "Self-tapping screws",
            "Shear connections"
          ],
