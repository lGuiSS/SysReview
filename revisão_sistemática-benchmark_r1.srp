        {
          "id": "web_of_science_1911",
          "title": "ANALYSIS AND CALCULATION OF REINFORCEMENT OF WOODEN FLOORS: CLT AS AN ALTERNATIVE TO REINFORCED CONCRETE INTRODUCTION",
          "authors": "Martinez Soriano, Fernando and Martinez Sierra, Enrique",
