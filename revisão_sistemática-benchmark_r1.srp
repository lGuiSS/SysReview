          "importDate": "2026-02-23T22:36:58.145Z",
          "lastModified": "2026-02-23T22:36:58.145Z"
        },
        {
          "id": "scopus_1051",
          "title": "Cross-laminated timber (CLT) - A state of the art report; Križno lamelirano drvo (CLT) - pregled stanja područja",
          "authors": "Jeleč, Mario and Varevac, Damir and Rajčič, Vlatka",
          "affiliations": "Sveučilište Josipa Jurja Strossmayera u Osijeku, Faculty of Civil Engineering, Osijek, Osijek-Baranja, Croatia; University of Zagreb, Faculty of Civil Engineering, Zagreb, Croatia",
          "countries": [
            "Croatia"
          ],
          "journal": "Gradjevinar",
          "year": 2018,
          "score": 17,
          "abstract": "Cross laminated timber is an innovative plate-shaped product presenting a laminated structure and excellent physicomechanical properties. Due to its high stiffness and in-plane and out-of-plane bearing capacity, it is most often used in form of wall or floor panels. Favourable environmental, aesthetic and energy properties further enhance its qualities. The paper is a summary of CLT research conducted so far, with an emphasis on the need to harmonise existing regulations and include this product in the European standard for timber structures Eurocode 5. © 2018 Union of Croatian Civil Engineers and Technicians. All rights reserved.",
          "keywords": [
            "Carrying capacity analysis",
            "CLT",
            "Composite material",
            "Cross laminated timber",
            "Eurocode 5",
            "Material properties"
          ],
          "studyType": "Review",
          "quality": null,
          "doi": "10.14256/JCE.2071.2017",
          "language": "English",
          "source": "Scopus",
          "numString": 2,
          "isDuplicate": false,
          "duplicateOf": null,
