      "id": "web_of_science_1953",
      "title": "Cerebellum and speech perception: A functional magnetic resonance imaging study",
      "authors": "Mathiak, K and Hertrich, I and Grodd, W and Ackermann, H",
      "affiliations": "Eberhard Karls University of Tubingen",
