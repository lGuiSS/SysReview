        {
          "id": "scopus_38",
          "title": "Production-oriented approach for optimal mass-customisation of floor panel layouts in cross-laminated timber (CLT) buildings",
          "authors": "Yousefi, Elham and Ahmadian Fard Fini, Alireza and Loganathan, Santhosh",
          "affiliations": "University of Technology Sydney, Faculty of Design, Architecture and Building, Sydney, NSW, Australia; University of Technology Sydney, Sydney, NSW, Australia; National Institute of Technology Tiruchirappalli, Department of Civil Engineering, Tiruchirappalli, TN, India",
