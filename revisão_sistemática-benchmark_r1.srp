  "protocol": {
    "title": "Proposta de equações para o cálculo de placas de CLT reforçadas com FRP",
    "researchQuestion": "Na literatura, há trabalhos que propuseram equações de abordagem tridimensional para estimar o comportamento à flexão (esforços internos, tensões ou deslocamentos) de placas de CLT reforçadas com fibras poliméricas?",
    "yearRange": {
      "start": 2015,
      "end": 2026
    },
    "languages": [
      "English"
    ],
    "inclusionCriteria": [
      {
        "id": "I1",
        "value": "Estudos com metodologias destinadas ao cálculo de esforços internos, tensões ou deslocamentos aplicados às placas de cross laminated timber reforçadas com FRP."
      }
    ],
    "exclusionCriteria": [
      {
        "id": "E1",
        "value": "Trabalhos cujo objeto de estudo não são placas de cross laminated timber."
      },
      {
        "id": "E2",
        "value": "Trabalhos que não priorizam a análise do comportamento à flexão de placas de CLT, tais como pesquisas direcionadas à análise do ciclo de vida, aos efeitos de vibrações, acústica, térmico e ao efeito global de edifícios."
      },
      {
        "id": "E3",
        "value": "Estudos não pautados em metodologias destinadas ao cálculo de esforços internos, tensões ou deslocamentos aplicados às placas de cross laminated timber reforçadas com FRP."
      },
