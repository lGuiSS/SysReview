        {
          "id": "scopus_924",
          "title": "Cross laminated timber (CLT) beams loaded in plane: Testing stiffness and shear strength",
          "authors": "Boggian, Francesco and Andreolli, Mauro and Tomasi, Roberto",
          "affiliations": "Università di Trento, Department of Civil, Trento, TN, Italy; Timber Tech srl, Trento, TN, Italy; Norges Miljø- og Biovitenskapelige Universitet, Faculty of Science and Technology, As, Viken, Norway",
