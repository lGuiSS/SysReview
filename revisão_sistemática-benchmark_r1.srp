    {
      "id": "scopus_502",
      "title": "ANALYSIS OF DIFFERENT NUMERICAL MODELLING STRATEGIES OF MULTI-STOREY CLT SHEAR WALLS",
      "authors": "Ruggeri, Elisabetta Maria and D'Arenzo, Giuseppe and Fossetti, Marinella and Seim, Werner",
      "affiliations": "Università degli Studi di Enna",
      "countries": [],
      "journal": "13th World Conference on Timber Engineering, WCTE 2023",
      "year": 2023,
      "score": 35,
      "abstract": "CLT platform-type buildings are characterized by a high level of redundancy due to the high number of connections used in the perimeter of the CLT panels. In this regard, in addition to the connections placed at the base of the walls, other structural components including the floor diaphragms and the lintels above the openings, along with their connections, influence the lateral performances of CLT shear walls. In this paper, an extensive analysis on the lateral behaviour of multi-storey CLT shear walls with openings realized with two different construction techniques is conducted. The study compares the results obtained from a simplified modelling strategy commonly used in practical design with more advanced modelling strategies that consider in detail the effects of structural interactions between floors and wall segments and between lintels and wall segments. The results of the elastic analyses conducted in this study showed significant differences in the lateral behaviour of systems analysed with the two modelling strategies, emphasizing that the simplified modelling strategies cannot always be reliable methodologies to describe the lateral behaviour of multi-storey CLT shear walls due to the significant effect of structural interactions provided by floors and lintels. © WCTE 2023.All rights reserved",
      "keywords": [
        "CLT structures",
        "Elastic analyses",
        "Multi-storey shear walls",
        "Numerical modelling",
        "Structural interactions"
      ],
      "studyType": "Conference paper",
      "quality": null,
      "doi": "10.52202/069179-0323",
      "language": "English",
