        {
          "id": "scopus_1235",
          "title": "Is cross-laminated timber suitable for building structures to thirty levels?",
          "authors": "Chapman, John B.",
          "affiliations": "University of Auckland, School of Architecture and Planning, Auckland, AUK, New Zealand",
          "countries": [
            "New Zealand"
          ],
          "journal": "Structures and Architecture: Concepts, Applications and Challenges - Proceedings of the 2nd International Conference on Structures and Architecture, ICSA 2013",
          "year": 2013,
          "score": 13,
          "abstract": "This paper considers if cross-laminated timber construction, which is commonly referred to as CLT, is suitable to support commercial buildings to thirty levels. It proposes a building system with CLT panels for a central tube core, columns and floor beams. The panels are arranged with the aims of achieving structural efficiency and minimal material wastage. The main structural element is a 96m high by 15.2m diameter central tube core. The core is made up of ninety-six full size panels that are interconnected to form one integrated element. The shear forces between the panels in the central core are transferred by 'shear teeth' which are hopefully simple to construct and unlikely to lead to significant joint slip. An analysis of the structure is reported and the paper concludes that the proposed system with CLT elements may be suitable for buildings to thirty levels. © 2013 Taylor & Francis Group.",
          "keywords": [
            "Architecture",
            "Laminating",
            "Office buildings",
            "Building structure",
            "Building systems",
            "Commercial building",
            "Cross laminated",
            "Integrated elements",
            "Material wastage",
            "Structural efficiencies",
            "Structural elements",
            "Timber"
          ],
