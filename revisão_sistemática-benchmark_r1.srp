        {
          "id": "web_of_science_2189",
          "title": "A Study on Flexure Behavior of AS4/914 Grade Carbon Fiber Reinforced Plastic Laminates under Static and Fatigue Loads",
          "authors": "Panbarasu, K. and Ranganath, V. R. and Prakash, V, Raghu",
