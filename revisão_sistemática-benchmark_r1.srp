        {
          "id": "scopus_607",
          "title": "Measurement of the Vibration Reduction Index for Cross-laminated Timber Walls in Canada",
          "authors": "Mahn, Jeffrey P. and Müller-Trapet, Markus and Cunha, Iara B.",
          "affiliations": "National Research Council Canada, Ottawa, ON, Canada",
          "countries": [
            "Canada"
          ],
          "journal": "Proceedings of the International Congress on Acoustics",
          "year": 2022,
          "score": 10,
          "abstract": "The National Research Council Canada has embarked on a study of the vibration reduction index of cross-laminated timber junctions with the aim of developing empirical models to estimate the values for the cross-laminated timber elements used in Canada. Changes to the fasteners including the use of resilient materials will be examined. In addition, the vibration reduction index between cross-laminated timber floors and lightweight timber walls will be measured. This type of construction is popular in high rise mass timber buildings in Canada where non-load bearing lightweight walls are used to reduce cost. The preliminary results of the study will be presented. © ICA 2022.All rights reserved",
          "keywords": [
            "Apparent transmission loss",
            "ASTC",
            "Cross-laminated timber"
          ],
