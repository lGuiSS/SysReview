        },
        {
          "id": "scopus_1198",
          "title": "Experimental tests of cross-lamited timber floors for timber-steel hybrid structures",
          "authors": "Loss, Cristiano and Piazza, Maurizio and Zandonini, Riccardo",
          "affiliations": "Università di Trento, Trento, TN, Italy",
          "countries": [
            "Italy"
          ],
          "journal": "WCTE 2014 - World Conference on Timber Engineering, Proceedings",
          "year": 2014,
          "score": 17,
          "abstract": "Hybrid structural systems built connecting steel elements to cross-laminated timber panels (CLT) can be a valid alternative to traditional systems for residential buildings. Such systems can combine the industrialized construction technology typical of steel systems with the advantages offered by CLT panels, lightness and stability. Moreover, CLT panels are renowned because timber is recognized to be an eco-friendly and eco-compatible material. In hybrid structural systems, the seismic-resistant capacity of the structure can be achieved by ensuring an adequate transmission of actions among the resistant elements, namely timber panels (floor and wall) and steel frame elements (beams and columns). Specifically, the interaction between the steel frame and the plain timber elements should ensure both the floor and the vertical walls bracing. The work presented hereafter concerns the study of the connections to be used among the different building components of the horizontal elements, with the aim of developing an effective force transmission between the materials, maximizing the level of prefabrication and industrialization of the final component. In particular, the preliminary results of the experimental tests carried out on full-scale steel-timber floor specimens, loaded by in-plane actions, will be presented.",
          "keywords": [
            "CLT",
            "Connections",
            "Cross laminated timber",
            "Floor diaphragm",
            "Hybrid structures",
            "In-plane diaphragm stiffness"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": null,
          "language": "English",
          "source": "Scopus",
          "numString": 2,
