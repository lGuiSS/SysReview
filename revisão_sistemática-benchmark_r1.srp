        },
        {
          "id": "web_of_science_1478",
          "title": "A Literature Review on Cold-Formed Steel-Timber Composite Structures",
          "authors": "Moritani, Fabiana Y. and Martins, Carlos E. J. and Dias, Alfredo M. P. G.",
          "affiliations": "Universidade de Coimbra",
          "countries": [],
          "journal": "BIORESOURCES",
          "year": 2021,
          "score": 7,
          "abstract": "State-of-the-art steel-timber composite structures (STC), using cold formed steel (CFS) and cross-laminated timber (CLT), are considered in this review. Literature on this type of construction solution is reviewed to provide an overview of the characteristics and advantages of STC. Previous experimental and numerical studies with STC structures, mainly composite solutions with CFS beams and CLT panels, are discussed to assess the behavior of this structural typology. A comprehensive description of the connection systems performance in different STC structures is also provided. Furthermore, the design and analytical methods currently available are presented. Likewise, details on aspects related to dynamic properties and fire resistance are discussed.",
          "keywords": [
            "Cold-formed steel",
            "Cross-laminated timber",
            "Composite structures",
            "Connection",
            "Hybrid structures",
            "Wood-based structures"
          ],
          "studyType": "Review",
          "quality": null,
          "doi": "10.15376/biores.16.4.Moritani",
