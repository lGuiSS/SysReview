            "Airborne sound insulation",
            "Airflow resistivity",
            "Floor-impact sound",
            "Homogeneous materials",
            "Insulation materials",
            "Sound transmission",
            "Torsional rigidity",
            "Wood frame construction",
            "Acoustic noise"
          ],
