    {
      "id": "scopus_753",
      "title": "Parametric study on stress concentrations around openings in CLT plates loaded out-of-plane",
      "authors": "González-Serna, Pablo and Schenk, Martin and Cabrero, J. M.",
      "affiliations": "Universidad de Navarra, Pamplona, Navarre, Spain; Technische Universität München, Munich, Bayern, Germany",
      "countries": [
        "Spain",
        "Germany"
      ],
      "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
      "year": 2021,
      "score": 30,
      "abstract": "A recent survey conducted by the InnoCrossLam project pointed out the need for guidance on the design of openings on CLT floors. Such situations require the analysis of the two main directions of the plate and the correct estimation of the local stress concentrations that appear around the openings. This paper presents the preliminary results of a parametric study on a set of FE models and a sensitivity analysis of the FE mesh definition. © WCTE 2021. All rights reserved.",
      "keywords": [
