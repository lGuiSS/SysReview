        {
          "id": "scopus_2010",
          "title": "FLEXURAL BEHAVIOR OF PROPOSED STEEL-TIMBER-CONCRETE COMPOSITE FLOOR SYSTEMS FOR MID-TO-HIGH-RISE BUILDINGS",
          "authors": "Kim, Chae-yeon and Kang, Min-su and Choi, Jong-soo and Shin, Jinwon and Yom, Kyong-soo and Choi, S. M.",
          "affiliations": "University of Seoul, Department of Architectural Engineering, Seoul, South Korea; Ltd., Seoul, Seoul, South Korea",
          "countries": [
            "South Korea"
          ],
          "journal": "Proceedings from the 14th World Conference on Timber Engineering: Advancing Timber for the Future Built Environment, WCTE 2025",
          "year": 2025,
          "score": 21,
          "abstract": "This study experimentally evaluates the flexural performance of an STC (Steel-Timber-Concrete) slab composed of steel (Z-section), concrete, and CLT, and aims to derive cross-sectional configurations and allowable spans applicable to mid-to-high-rise timber buildings. A total of six specimens were fabricated and tested under a two-point loading setup, comparing flexural stiffness and strength before and after concrete hardening. The results show improved flexural performance with increasing Z-section thickness and rebar diameter, and that STC slabs could achieve an allowable span of up to 6.25 m after concrete hardening. In particular, the STCJZ slab, with its thermal storage effect of concrete and joist reinforcement, showed favorable fire resistance characteristics. This study experimentally demonstrates the practical feasibility of STC slabs as a structural alternative for high-rise timber construction. © (2025) WORLD CONFERENCE ON TIMBER ENGINEERING 2025 (WCTE 2025) All rights reserved.",
          "keywords": [
            "Composite floors",
            "Flexural behavior",
            "Mid-to-high-rise timber buildings",
            "Steel-timber-concrete"
          ],
