    {
      "id": "scopus_30",
      "title": "Instantaneous and long-term structural behavior of timber-flax beams: Design and evaluation of the hybrid flax pavilion component",
      "authors": "Chen, Tzuying and Prandini, Renan and Neubauer, Gregor and Hänzka, Sven and Knippers, Jan",
      "affiliations": "Universität Stuttgart, Stuttgart, Baden-Wurttemberg, Germany; Universität Stuttgart, Cluster of Excellence Integrative Computational Design and Construction for Architecture (IntCDC), Stuttgart, Baden-Wurttemberg, Germany",
      "countries": [
        "Germany"
      ],
      "journal": "Developments in the Built Environment",
      "year": 2025,
      "score": 9,
      "abstract": "The construction industry significantly contributes to global carbon emissions and resource depletion, necessitating a transition toward more sustainable materials. Renewable materials show high potential as an alternative to conventional fossil-based materials in mitigating climate change within the construction industry. Diversifying the sourcing, especially for plant-based materials, is imperative to ensure sustainability and prevent overreliance on specific resources. In prior studies, Coreless Filament Wound (CFW) natural fiber-reinforced polymer (NFRP) systems have demonstrated promising material efficiency and structural performance. However, the lack of research on their long-term performance in construction applications presents a significant barrier to widespread market adoption. This study addresses this gap by designing, developing, and evaluating the Hybrid Fibre Pavilion constructed for the 2024 Landesgartenschau in Wangen im Allgäu. The pavilion incorporates simply supported beams fabricated from robotically wound NFRPs and cross-laminated timber (CLT) slabs. Full-scale structural components were robotically manufactured and subjected to distributed ultimate load, creep, and cyclic load tests. The findings highlight the viability of this hybrid structural system, demonstrating its potential for robust instantaneous and long-term performance in construction. © 2025 The Authors.",
      "keywords": [
        "Bio-based materials",
        "Creep behavior",
        "Fibre-polymer composites",
        "Fibrous architecture",
        "Flax fiber composites",
        "Hybrid material system",
        "Mechanical performance"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1016/j.dibe.2025.100782",
      "language": "English",
      "source": "Scopus",
      "numString": 2,
