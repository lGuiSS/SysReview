          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:36:58.161Z",
          "lastModified": "2026-02-23T22:36:58.161Z"
        },
        {
          "id": "scopus_1163",
          "title": "Influence of connection systems on serviceability response of CLT timber flooring",
          "authors": "Chúláin, Caitríona Uí and Sikora, Karol S. and Harte, Annette M.",
          "affiliations": "University of Galway, Galway, Connacht, Ireland",
          "countries": [
            "Ireland"
          ],
          "journal": "WCTE 2016 - World Conference on Timber Engineering",
          "year": 2016,
          "score": 16,
          "abstract": "In this paper finite element analysis of a five layer cross-laminated timber (CLT) rectangular floor is presented. The model was developed using 3D shell elements with linear elastic orthotropic material properties. Support conditions analysed included fully fixed, semi-rigid and simply supported, and both one and two-way span conditions were considered. For each case, the serviceability deflection was determined from a static small displacement analysis and the first three natural frequencies bending and torsional mode shapes, within a 0-80 Hz range, from mode frequency analysis. The analysis shows that the maximum displacement and frequency response are significantly impacted by the support stiffness and the number of edges supported. These results will contribute to determining the optimum fixing configuration with regard to serviceability limit design (SLD) for various CLT floor geometries.",
          "keywords": [
            "Cross-laminated timber",
            "Finite element analysis",
            "Mass-timber",
            "Serviceability limit design",
            "Timber floors"
          ],
