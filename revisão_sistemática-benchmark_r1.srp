        {
          "id": "scopus_2114",
          "title": "Theoretical and experimental evaluation of FRP components and systems",
          "authors": "Sotiropoulos, Sotiris N. and GangaRao, Hota V.S. and Mongi, Ahmed N.K.",
          "affiliations": "West Virginia University, Morgantown, WV, United States; West Virginia University, Morgantown, WV, United States; West Virginia Department of Transportation, Charleston, WV, United States",
          "countries": [
