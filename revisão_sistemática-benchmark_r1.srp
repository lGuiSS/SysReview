    {
      "id": "scopus_1060",
      "title": "Double ceiling system with cross laminated timber panels",
      "authors": "Tanaka, Manabu and Murakami, Tsuyoshi and Kasai, Yusuke",
      "affiliations": "General Building Research Corporation of Japan, Suita, Osaka, Japan",
      "countries": [
        "Japan"
      ],
      "journal": "Journal of Environmental Engineering (Japan)",
      "year": 2017,
      "score": 38,
      "abstract": "The purpose of this study is to estimate the improvement effect to floor impact sound insulation performance by double ceiling system with cross laminated timber panels (=CLT panels). Floor impact sound insulation experiments concerning CLT panel double ceiling systems with eight arrangements were carried out in the laboratory-. From the results, CLT panel double ceiling system tested in this research was revealed to have more effectiveness to heavy/soft floor impact sound insulation than common gypsum boards double ceiling system Further, sound pressure in the back cavity and vibration of ceiling panels were also measured and discussed.",
      "keywords": [
        "Double ceiling system",
        "Floor impact sound",
        "Ooss laminated timber",
        "Reduction effect"
      ],
