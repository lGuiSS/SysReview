    {
      "id": "scopus_1074",
      "title": "Case Study: University of British Columbia's 18-storey TallWood House at Brock Commons",
      "authors": "Fast, Paul A. and Jackson, Robert",
      "affiliations": "Fast + Epp, Vancouver, BC, Canada",
      "countries": [
        "Canada"
      ],
      "journal": "IABSE Conference, Vancouver 2017: Engineering the Future - Report",
      "year": 2017,
      "score": 19,
      "abstract": "The TallWood House at Brock Commons is an 18-storey mass timber hybrid student residence under construction at the University of British Columbia in Vancouver, Canada. When completed in the spring of 2017 it will be 53m high - the tallest contemporary mass timber hybrid building in the world. Structural engineers at Fast + Epp collaborated with Acton Ostry Architects and Hermann Kaufmann Architekten. This paper will outline some of the unique structural engineering challenges associated with this mass timber building and the design strategies used to overcome them. Specific topics include two-way point supported CLT floor slabs, axial column shortening, CLT diaphragm design, tolerances, as well as dynamic wind induced vibrations. It will also review the project's pre-fabrication process, on-site construction sequencing, and lessons learned. © 2018 Ingenta.",
      "keywords": [
        "Axial column shortening",
        "CLT",
        "Diaphragm design",
        "Tall wood",
