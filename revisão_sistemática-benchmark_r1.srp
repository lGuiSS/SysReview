        },
        {
          "id": "scopus_129",
          "title": "EXPERIMENTAL CHARACTERIZATION OF THE INNOVATIVE RADIAL CONNECTION SYSTEM",
          "authors": "Grossi, Paolo and Fanti, Riccardo and Polastri, Andrea and Callegari, Ernesto and Blass, Hans Joachim",
          "affiliations": "Rotho Blaas srl, Cortaccia/Kurtatsch, Italy; Institute of Bioeconomy-National Research Council of Italy (CNR-IBE), San Michele all'Adige, TN, Italy; BE Ingenieure GmbH, Karlsruhe, Baden-Wurttemberg, Germany",
          "countries": [
            "Italy",
            "Germany"
          ],
          "journal": "Proceedings from the 14th World Conference on Timber Engineering: Advancing Timber for the Future Built Environment, WCTE 2025",
          "year": 2025,
          "score": 6,
          "abstract": "The mechanical behavior of an mnovative connector named RADIAL was investigated by means of an extensive experimental campaign. An analytical calculation method was developed based on experimental results. A senes of monotomc tests in tensile, compression, and in-plane shear configuration were performed on three different typologies of connectors (named RADIAL90, RADIAL60D and RADIAL60S). RADIAL consists of a semi-circular shaped steel element with one or two welded steel flanges. The connector must be screwed in a proper hole made in timber element (e.g. glulam or cross laminated timber). The screws are radially arranged and are subjected primarily to tensile forces. RADIAL elements may be used as panel-to-panel joints or as anchor point for cross laminated timber panel as well as the central hinged connection between two glulam/sohd wood elements (e.g. roof trusses). Results showed that all three typologies of RADIAL are characterized by high resistance and stiffness in different load configurations. An overview of the tests is presented in this paper. © (2025) WORLD CONFERENCE ON TIMBER ENGINEERING 2025 (WCTE 2025) All rights reserved.",
          "keywords": [
            "DID",
            "experimental tests",
            "multi-directional connections",
            "prefabricate",
            "timber connections"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": "10.52202/080513-0215",
          "language": "English",
