        {
          "id": "web_of_science_1471",
          "title": "Structural performance of CLT moment connections in the minor strength axis",
          "authors": "Hosseini, A. and Shahnewaz, M. and Zhou, J. and Tannert, T.",
          "affiliations": "University of Northern British Columbia",
          "countries": [],
          "journal": "ENGINEERING STRUCTURES",
          "year": 2025,
          "score": 16,
          "abstract": "Cross-laminated timber (CLT) panels can offer effective two-way span action in point-supported floors. Due to the width limitations of CLT panels, connections are required to provide continuity in the minor strength axis. In this study, the out-of-plane structural performance of such connections was assessed using four-point and three-point bending tests. Four connection types were investigated: i) screwed plywood splines; ii) glued plywood splines; iii) screwed T-joints; and iv) wooden X-fix shear keys. The glued splines exhibited the highest rotational stiffness, while the screwed splines and T-joints provided moderate ductility. Following the experimental phase, a numerical model, validated by the experimental results, was employed to evaluate the performance of pointsupported floors with connections in the minor strength direction of the CLT panels. Increasing the rotational stiffness from 500 to 5000 kNmrad-1m-1 significantly improved floor performance, reducing the deflection by about 50 \\%, while further increases in rotational stiffness had a negligible impact. Screwed splines met required strength and serviceability requirements, whereas glued splines substantially exceeded these requirements.",
          "keywords": [
            "Cross-laminated timber",
            "Self-tapping screws",
            "T -joint",
            "X -fix",
            "Connection"
          ],
          "studyType": "Article",
          "quality": null,
          "doi": "10.1016/j.engstruct.2025.119788",
