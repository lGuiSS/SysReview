        {
          "id": "scopus_2083",
          "title": "A Computational Analysis of the Energy Harvested by Gfrp and Nfrp Laminated Beams under Cyclic Loading",
          "authors": "Fragoudakis, Roselita and Gallagher, John A. and Kim, Vladimir",
          "affiliations": "Merrimack College, Department of Mechanical Engineeeirng, North Andover, MA, United States",
          "countries": [
            "United States"
          ],
          "journal": "Procedia Engineering",
          "year": 2017,
          "score": 11,
          "abstract": "This paper investigates the possibility of energy harvesting using Fiber Reinforced Plastic beams under cyclic loading. The behaviour of E-glass fiber/epoxy and Hemp fiber/epoxy laminated beams reinforced with piezoelectric fibers is examined by evaluating their bending strain and deflection. An optimum stacking sequence for all types of reinforcement: E-glass fibers, hemp fibers, and piezoelectric fibers, is suggested such that energy harvesting potential is maximized while failure and damage accumulation remain at low levels. © 2017 The Authors. Published by Elsevier Ltd.",
          "keywords": [
            "Classical Lamination Theory (CLT)",
            "Energy Harvesting",
            "Glass Fiber Reinforced Plastics (GFRP)",
            "Laminated Beams",
