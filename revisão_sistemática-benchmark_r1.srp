    {
      "id": "scopus_486",
      "title": "STUDY ON FAILURE MECHANISMS OF HYBRID STRUCTURE OF REINFORCED CONCRETE FRAME WITH CLT INFILL",
      "authors": "Alwashali, Hamood and Aljuhmani, Ahmad Ghazi",
      "affiliations": "Okayama University, Okayama, Okayama, Japan; Tohoku University, Sendai, Miyagi, Japan",
      "countries": [
        "Japan"
      ],
      "journal": "13th World Conference on Timber Engineering, WCTE 2023",
      "year": 2023,
      "score": 46,
      "abstract": "The objective of this study is to clanfy the possible failure mechanisms and strength of RC frames with CLT infill, and to investigate the CLT panel compression strut width. Five failure mechanisms and a simplified strength evaluation method were proposed based on a literature review of the RC frames with different material infills. Experimental tests of diagonal compression of CLT panels were conducted and results were used in finite element analysis to evaluate the change of failure mechanisms based on strut width and relative stiffness for the RC frame and CLT. © (2023) WORLD CONFERENCE ON TIMBER ENGINEERING 2023 (WCTE 2023) All rights reserved.",
      "keywords": [
        "CLT infill panels",
        "Hybrid structures",
        "Reinforced concrete buildings",
        "Seismic capacity"
      ],
