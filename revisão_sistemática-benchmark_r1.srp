        {
          "id": "scopus_752",
          "title": "Design and construction of a novel two-way flat slab system using cross-laminated timber",
          "authors": "Murakami, Katsuhide and Esaka, Yoshisato and Mimatsu, Azusa and Murakami, Masahide",
          "affiliations": "Nikken Sekkei Ltd., Tokyo, Japan; Kindai University, Faculty of Architecture, Higashiosaka, Osaka, Japan",
          "countries": [
            "Japan"
          ],
          "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
          "year": 2021,
          "score": 22,
          "abstract": "The authors have developed a cross-laminated timber (CLT) two-way flat slab system comprised of multiple CLT layers overlaid upon each other (to resist vertical loading) in combination with CLT shear walls (to support against lateral actions such as earthquakes. The system has been adopted in the roof design for the Miyako Shimoji-shima Airport Terminal Departure Building on Miyako Island, Japan. CLTs are joined together in the short- and long-span directions using glued-in rods (GIR joints). The authors have also developed a FEM shell model for design use. It is shown that the FEM analysis shell model results agree relatively well with full-scale deflection measurements. This paper describes the structural design, lab experiments and construction-stage observations of the proposed CLT system. © WCTE 2021. All rights reserved.",
          "keywords": [
            "Cross laminated timber",
            "FEM-analysis",
            "Flat slab system",
            "Glued-in rod joint",
            "Keyed beam"
          ],
