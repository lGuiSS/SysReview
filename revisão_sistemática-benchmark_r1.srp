        },
        {
          "id": "scopus_292",
          "title": "A wave-based approach to predict the vibration transmission across junctions with elastic interlayers",
          "authors": "Moons, Stijn and Lanoye, Reinhilde and Reynders, Edwin P.B.",
          "affiliations": "KU Leuven, Department of Civil Engineering, Leuven, Vlaams-Brabant, Belgium; CDM Stravitec, Overijse, Belgium",
          "countries": [
            "Belgium"
          ],
          "journal": "Proceedings of ISMA 2024 - International Conference on Noise and Vibration Engineering and USD 2024 - International Conference on Uncertainty in Structural Dynamics",
          "year": 2024,
          "score": 5,
          "abstract": "In a building acoustics context, the vibration transmission between walls and floors can be critical for the overall sound insulation between two rooms. Vibration isolation measures including elastic interlayers are often included in the junction design, but their mechanical behavior is complex. In this work, coupling loss factors for waves transmitted across a junction are predicted using an analytical approach for thin semi-infinite orthotropic plates and elastic interlayers. The interlayers are modelled as either thin plates, thick flexible waveguides with negligible bending stiffness or distributed springs. The prediction models are validated for a cross-laminated timber T-junction with a polyurethane foam interlayer. The predictions are in moderate agreement with the experimental results with deviations below 10 dB across all 1/3 octave bands in the entire frequency range. The thick waveguide model has the best performance, the simplified spring model which does not take interlayer inertia effects into account, is applicable up to approximately 1000 Hz. © 2024 Proceedings of ISMA 2024 - International Conference on Noise and Vibration Engineering and USD 2024 - International Conference on Uncertainty in Structural Dynamics. All rights reserved.",
          "keywords": [
            "Acoustic noise",
            "Architectural acoustics",
            "Machine design",
            "Pressure vessels",
            "Rigid foamed plastics",
            "Sound insulation",
            "Vibration analysis",
            "Waveguide junctions",
            "Analytical approach",
            "Bending stiffness",
            "Building acoustics",
            "Coupling loss factors",
            "Flexible waveguides",
            "Junction design",
            "Mechanical behavior",
            "Thin plate",
            "Vibration isolations",
            "Vibration transmission",
            "Orthotropic plates"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": null,
          "language": "English",
