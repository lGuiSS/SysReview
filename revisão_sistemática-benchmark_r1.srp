    {
      "id": "scopus_891",
      "title": "Experimental Seismic Response of a Resilient 2-Story Mass-Timber Building with Post-Tensioned Rocking Walls",
      "authors": "Pei, Shiling and van de Lindt, John W. and Barbosa, Andre R. and Berman, Jeffrey W. and McDonnell, Eric and Daniel Dolan, J. and Blomgren, Hans Erik and Zimmerman, Reid B. and Huang, Da and Wichman, Sarah K.",
      "affiliations": "Colorado School of Mines, Department of Civil & Environmental Engineering, Golden, CO, United States; Walter Scott, Jr. College of Engineering, Fort Collins, CO, United States; College of Engineering, Corvallis, OR, United States; UW College of Engineering, Seattle, WA, United States; KPFF Consulting Engineers Inc., Tacoma, WA, United States; Voiland College of Engineering and Architecture, Pullman, WA, United States; Katerra, Seattle, WA, United States",
      "countries": [
