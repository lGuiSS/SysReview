      "articles": [
        {
          "id": "web_of_science_2115",
          "title": "Bending performance of domestic larch cross-laminated timber reinforced with fiber-reinforced polymer",
          "authors": "Baek, Seungyoup and Song, Yojin and Hong, Soonil",
          "affiliations": "Kangwon National University",
          "countries": [],
          "journal": "WOOD MATERIAL SCIENCE \\& ENGINEERING",
          "year": 2025,
          "score": 78,
          "abstract": "The added fiber-reinforced polymer (FRP) to cross-laminated timber (CLT) panels is expected to enable cost down and light-weight of the floor slab and improve bending performance. In this study, FRP was reinforced in Larix kaempferi 5-layer CLT, which was two types FRP and three types of reinforcement locations. The FRPs used Glass Fiber Cloth (GFC) and Carbon Fiber Reinforced Plastic sheet (CFRP). The reinforcement locations were the outermost tensile part, between the outermost tensile layer and the Minor strength direction layer, and between all layers. The bending performance of FRP-reinforced CLTs was evaluated and compared with unreinforced CLTs (control). The specimens reinforced with FRP between the outermost tensile layer and the minor strength direction layer had delamination, decreasing the modulus of rupture (MOR). The specimen with reinforced GFC between all layers improved bending performance but had delamination. The specimen reinforced with GFC in the outermost tensile component of the CLT improved bending performance but had tensile failure. However, CFRP has suppressed the tensile failure of CLT and improved bending performance by introducing consistent rolling shear failure. The reinforcement of CFRP on the outermost tensile section of CLT resulted in a 57\\% improvement in MOR compared to the control.",
          "keywords": [
            "Larix kaempferi carr",
            "cross-laminated timber (CLT)",
            "glass fiber cloth (GFC)",
            "carbon fiber reinforced plastic (CFRP) sheet",
            "MOR"
          ],
          "studyType": "Review",
          "quality": null,
