    {
      "id": "scopus_1978",
      "title": "Behaviour of glulam and CLT elements reinforced with CFRP",
      "authors": "Gergi, Milad and Doudak, Ghasan",
      "affiliations": "University of Ottawa, Ottawa, ON, Canada",
      "countries": [
        "Canada"
      ],
      "journal": "Engineering Structures",
      "year": 2026,
      "score": 56,
      "abstract": "The popularity of wood as a construction material has grown in recent decades due to considerations for sustainability as well as the increased availability of engineered wood products. To further enhance wood’s mechanical characteristics, attempts have been made to reinforce structural elements particularly on the tension side, where the failure is brittle. This study aims to investigate the impact of various retrofitting options on enhancing the overall behaviour of engineered wood products subjected to out of plane loading. An experimental program was developed to investigate the behaviour of 21 timber elements, comprising glulam and CLT members, with a focus on the flexural behaviour of elements with and without the effect of multi-directional FRP reinforcement. The results found that applying a tension laminate only was not effective due to premature detachment. Extending the reinforcement to the sides of the timber element in a U-shaped configuration provided a significant increase in strength. In general, the fabric consisting of bidirectional 0/90 fibers increased the peak strength, while fabric with bidirectional 45/45 enhanced the ductility of the retrofitted element. An analytical model based on a cross-sectional numerical analysis was developed and validated. It was shown that the model could predict the behaviour of retrofitted beams with reasonable accuracy. © 2025 The Author(s). Published by Elsevier Ltd. This is an open access article under the CC BY-NC-ND license. http://creativecommons.org/licenses/by-nc-nd/4.0/",
      "keywords": [
        "Engineered wood products",
        "FRP",
        "Post-peak",
        "Reinforcement"
      ],
      "studyType": "Article",
      "quality": null,
