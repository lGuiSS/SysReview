      "id": "web_of_science_1873",
      "title": "Behavior of timber-concrete composite with defects in adhesive connection",
      "authors": "Buka-Vaivade, Karina and Serdjuks, Dmitrijs",
      "affiliations": "Riga Technical University",
      "countries": [],
      "journal": "4TH INTERNATIONAL CONFERENCE ON STRUCTURAL INTEGRITY (ICSI 2021)",
