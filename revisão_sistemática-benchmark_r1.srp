    {
      "id": "scopus_494",
      "title": "EXPLORING THE STRUCTURAL DESIGN, COST AND DURABILITY OF MASS TIMBER NOISE BARRIER FOR HIGHWAY APPLICATIONS",
      "authors": "Pang, Weichiang and Stoner, Michael W. and Bothra, Harsh and Redmond, Laura M. and Layton, Patricia A.",
      "affiliations": "Clemson University, Clemson, SC, United States; Reackon Concrete Pvt Ltd, United States; Clemson University, Wood Utilization + Design Institute, Clemson, SC, United States",
      "countries": [
        "United States"
      ],
      "journal": "13th World Conference on Timber Engineering, WCTE 2023",
      "year": 2023,
      "score": 13,
      "abstract": "The sound generated from vehicular traffics on highways cause noise pollution. To deal with the traffic noise coming from these highways, noise barriers have been erected across major highways. Currently, the primary material used for highway noise barrier is concrete. This paper explores the use of mass timber as highway noise barrier from a structural design, cost, and durability perspective. The structural design of mass timber noise barrier to resist wind and earthquake loadings will be discussed. Cost comparisons between noise barriers constructed using pre-cast concrete panels and cross-laminated timber panels indicate that mass timber noise barrier is cost competitive. As part of this study, a prototype noise barrier was constructed for evaluating the constructability of the proposed design and for monitoring the moisture performance in an exposed weather environment. © (2023) WORLD CONFERENCE ON TIMBER ENGINEERING 2023 (WCTE 2023) All rights reserved.",
      "keywords": [
        "Cross-Laminated Timber",
        "Highway",
        "Noise Barrier"
      ],
      "studyType": "Conference paper",
      "quality": null,
      "doi": "10.52202/069179-0125",
