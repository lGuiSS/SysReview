        {
          "id": "scopus_1158",
          "title": "Influence of layer and laminate characteristics on shear properties of cross laminated timber and hybrids",
          "authors": "Niederwestberg, Jan and Chui, Yinghei and Gong, Meng",
          "affiliations": "University of New Brunswick, Fredericton, NB, Canada",
          "countries": [
            "Canada"
          ],
          "journal": "WCTE 2016 - World Conference on Timber Engineering",
          "year": 2016,
          "score": 21,
          "abstract": "In-plane shear and planar shear due to out-of-plane bending are important properties for the design of CLT-type floor systems. Properties of CLT-type panels are influenced by the orientation of the layer's major stiffness directions and the properties of their layers. The layers are influenced by their characteristics, laminate aspect ratio, growth ring orientation and edge-gluing. In order to utilize the mechanical potential of CLT-type panels, it is necessary to understand the effects of layer and laminate properties on CLT performance. CLT and CLT-hybrid panels were tested in planar and in-plane shear tests. The shear properties were evaluated using static and modal test procedures, the accuracy of non-destructive test methods was evaluated. Relationships between specimen properties and the characteristics of laminates and layers, such as aspect ratio, growth ring orientation and edge-gluing, were established.",
          "keywords": [
            "Cross laminated timber (CLT)",
            "Hybrid",
            "Layer characteristics",
            "Rolling shear",
            "Shear properties"
          ],
