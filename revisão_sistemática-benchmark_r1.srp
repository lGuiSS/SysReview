        {
          "id": "scopus_978",
          "title": "Characterization and structural performance in bending of CLT panels made from small-diameter logs of Loblolly/Slash pine",
          "authors": "Baño, Vanesa and Godoy, Daniel and Figueredo, Diego and Vega, Abel",
          "affiliations": "Universidad de la Republica, Instituto de Estructuras y Transporte, Montevideo, Uruguay; Universidad de la Republica, Instituto de Ensayo de Materiales, Montevideo, Uruguay; Forest and Wood Technology Research Centre (CETEMAS), Siero, Asturias, Spain",
