    {
      "id": "scopus_930",
      "title": "Environmental response of a CLT floor panel: Lessons for moisture management and monitoring of mass timber buildings",
      "authors": "Schmidt, Evan L. and Riggio, Mariapaola and Barbosa, Andre R. and Mugabo, Ignace",
      "affiliations": "Oregon State University, Department of Wood Science and Engineering, Corvallis, OR, United States; Oregon State University, School of Civil and Construction Engineering, Corvallis, OR, United States",
      "countries": [
        "United States"
      ],
      "journal": "Building and Environment",
      "year": 2019,
      "score": 42,
      "abstract": "Cross-laminated timber (CLT) is becoming increasingly adopted into North American construction, yet little is known about the impacts of environmental exposure (e.g., to rain during construction) on its long-term performance. The lack of protocols for on-site moisture protection in North America makes it a pressing matter to determine general moisture responses of this material in order to establish a behavioral baseline for practitioners and future researchers. A CLT floor panel sample was exposed to cycles of wetting and drying in an environmental chamber. During these cycles, physical and geometrical properties of the panel were monitored. Testing results indicate that discontinuities in the layup CLT affects the hygroscopic behavior of the product. While the panel showed high dimensional stability, it also exhibited checking, cupping, and interfacial shearing after cycling. Bending test results before and after cycling indicated a reduction of the structural capacity due to the weathering. © 2018",
      "keywords": [
        "Cross-laminated timber",
        "Hygrothermal performance",
        "Mass timber",
        "Moisture"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1016/j.buildenv.2018.11.038",
      "language": "English",
      "source": "Scopus",
      "numString": 2,
      "isDuplicate": false,
      "duplicateOf": null,
      "dataProcessingStatus": "included",
      "filter1Status": "pending",
