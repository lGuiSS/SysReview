        {
          "id": "scopus_636",
          "title": "Bending Performance of Timber-Timber Composite Floors",
          "authors": "Shahnewaz, Md and Dickof, Carla and Tannert, Thomas",
          "affiliations": "Fast + Epp, Vancouver, BC, Canada; University of Northern British Columbia, Prince George, BC, Canada",
          "countries": [
            "Canada"
          ],
          "journal": "Lecture Notes in Civil Engineering",
          "year": 2022,
          "score": 20,
          "abstract": "Experimental investigations on Timber-Timber Composite (TTC) floor systems composed of Cross-Laminated Timber (CLT)-glulam are presented in this paper. The floor system was designed as part of two projects in Vancouver, the Sir Matthew Begbie Elementary School and the Bayview Elementary School. Quasi-static monotonic tests were conducted on full-scale 9.1 m long and 1.2 m wide double T-shaped ribbed composite floor segments. The TTC floors consisted of 3-ply CLT panels and two glulam beams connected by three different means: i) screws installed at 90°, ii) screws installed at 45°, and ii) screws installed at 90° with an additional adhesive bond. Six monotonic tests were conducted with two replicates from each type. While all three-floor types reached similar average load-carrying capacities, the TTC floors combining screws with glue exhibited the highest stiffness. © 2022, Canadian Society for Civil Engineering.",
          "keywords": [
            "Adhesives",
            "Floors",
            "Laminated composites",
            "Laminating",
            "Timber",
            "Bending performance",
