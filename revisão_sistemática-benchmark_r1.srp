        {
          "id": "scopus_2009",
          "title": "GLUED-IN PLATES: NEW POSSIBLE SOLUTION FOR SLAB-COLUMN CONNECTION IN POINT SUPPORTED TIMBERBASED SLABS",
          "authors": "Kázsmér, Michal and Sandanus, Jaroslav",
          "affiliations": "Slovak University of Technology in Bratislava, Bratislava, Bratislava Region, Slovakia",
          "countries": [
            "Slovakia"
          ],
          "journal": "Proceedings from the 14th World Conference on Timber Engineering: Advancing Timber for the Future Built Environment, WCTE 2025",
          "year": 2025,
          "score": 26,
          "abstract": "The current push from the scientific and engineering community for high-span point-supported slabs from cross-laminated timber (CLT), requires reinforcement solutions for punching the slab. This paper explores new methods of reinforcement with glued-in plates. It describes a new product for slab-column connection and proves its potential with numerical analysis. The major challenge is the resistance of a timber-glue-steel connection and the critical perimeter for punching shear verification. Results indicate that the reinforced slab exhibits an increase in punching capacity by a factor of 1.63, shifting the failure mode from rolling shear failure to bending tensile stress failure in the cover lamellae of CLT. © (2025) WORLD CONFERENCE ON TIMBER ENGINEERING 2025 (WCTE 2025) All rights reserved.",
          "keywords": [
            "Cross-laminated timber",
            "point supported slab",
            "reinforcement methods",
            "system connector"
          ],
