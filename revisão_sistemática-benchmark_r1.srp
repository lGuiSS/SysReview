      "id": "scopus_1041",
      "title": "Interlocking shear wall connections",
      "authors": "Claus, Timo and Riehle, Tobias and Seim, Werner and Götz, Tobias",
      "affiliations": "Universität Kassel, Timber Structures and Building Rehabilitation, Kassel, Hessen, Germany; Pirmin Jung Germany GmbH, Germany",
      "countries": [
