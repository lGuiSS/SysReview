      "id": "web_of_science_1399",
      "title": "Experimental dataset for effective bending stiffness and load-carrying capacity of CLT-concrete composite floor systems",
      "authors": "Shahnewaz, Md and Jackson, Robert and Tannert, Thomas",
      "affiliations": "University of Northern British Columbia",
