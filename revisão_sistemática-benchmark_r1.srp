    {
      "id": "scopus_75",
      "title": "Vibration performance of CLT and CLT-concrete composite floors supported by glulam beams under human activity in mass timber office buildings",
      "authors": "Malek, Sardar and Cheraghi-Shirazi, Najmeh and Creagh, Ariel and Setiawan, Fendy and Parra, Roger and Khoshkbari, Parham",
      "affiliations": "University of Victoria, Department of Civil Engineering, Victoria, BC, Canada; Centre for Advanced Materials and Related Technology, Victoria, BC, Canada; Degenkolb Engineers, San Francisco, CA, United States; Google LLC, Mountain View, CA, United States",
      "countries": [
        "Canada",
        "United States"
      ],
      "journal": "Engineering Structures",
      "year": 2025,
      "score": 43,
      "abstract": "Timber floors are susceptible to vibration due to their low mass and bending stiffness. Utilizing mass timber products in long-span scenarios, such as in office buildings, makes vibration an important design driver for structural engineers. To gain insight on the vibration performance of mass timber and timber-composite floors in real mass timber buildings, a comprehensive testing campaign was conducted on two mass timber office buildings. The measured data were compared and discussed according to various standards and design guides at the end. Although some discrepancies between estimated parameters and measurements were noted, the floors reasonably meet their desired performance objectives for office buildings according to existing standards. The results presented in this paper not only demonstrate the effect of human weight and walking path on the floor's response, but also provide important data on mass timber floor system performance in furnished buildings, which is not otherwise available in the literature. © 2025 The Authors",
      "keywords": [
        "Codes and standards",
        "Composite floors",
        "Cross-Laminated Timber (CLT)",
        "Human-induced vibration",
        "Long-span floors",
        "Mass timber",
        "Office buildings",
        "Walking test"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1016/j.engstruct.2025.119918",
      "language": "English",
      "source": "Scopus",
