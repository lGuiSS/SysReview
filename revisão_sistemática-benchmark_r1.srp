    {
      "id": "scopus_767",
      "title": "The new U.S. Mass Timber Floor vibration design guide",
      "authors": "Breneman, Scott E. and Zimmerman, Reid B. and Gerber, Adam and Epp, Lucas and Dickof, Carla and McDonnell, Eric",
      "affiliations": "WoodWorks - Wood Products Council, Deer Park, WA, United States; KPFF Consulting Engineers Inc., Tacoma, WA, United States; ASPECT Structural Engineers, Vancouver, BC, Canada; StructureCraft Builders, Inc., Abbotsford, BC, Canada; Fast + Epp, Vancouver, BC, Canada; Holmes Structures, Portland, OR, United States",
      "countries": [
        "United States",
        "Canada"
      ],
      "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
      "year": 2021,
      "score": 36,
      "abstract": "A U.S. Mass Timber Floor Vibration Design Guide has been developed as a synthesis of available information for use by designers considering response of occupied floors to excitation by human walking. The Design Guide includes a discussion of applicable vibration design methods, modelling recommendations, three design examples, and guidelines for developing finite element models specific to floor vibration analysis of mass timber floors. This paper provides an over of the Design Guide including presenting some of the developed recommendations for modelling of composite behavior and performance targets applicable to design of mass timber floor systems in the U.S. © WCTE 2021. All rights reserved.",
      "keywords": [
        "Beam-supported floors",
        "Cross-Laminated Timber",
        "Design methods",
