        {
          "id": "scopus_1284",
          "title": "Investigation of vibration behaviour of floors made of cross laminated timber (CLT); Untersuchung des Schwingungsverhaltens von Deckensystemen aus Brettsperrholz (BSP)",
          "authors": "Bogensperger, Thomas and Fitz, M. and Hamm, Patricia and Schickhofer, Gerhard",
          "affiliations": "Technische Universitat Graz, Institut für Holzbau und Holztechnologie, Graz, Styria, Austria; Tragwerksplaner Ferdi Heeb AG, Liechtenstein; Technische Universität München, Munich, Bayern, Germany; Technische Universitat Graz, Institut für Holzbau und Holztechnologie, Graz, Styria, Austria",
