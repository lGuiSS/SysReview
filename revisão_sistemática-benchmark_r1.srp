    {
      "id": "scopus_1216",
      "title": "Tests on glulam-CLT shear connections with double-sided punched metal plate fasteners and inclined screws",
      "authors": "Jacquier, Nicolas and Girhammar, U. A.",
      "affiliations": "Luleå University of Technology, Div. of Structural Engineering - Timber Structures, Lulea, Norrbotten, Sweden",
      "countries": [
        "Sweden"
      ],
      "journal": "Construction and Building Materials",
      "year": 2014,
      "score": 32,
      "abstract": "A new shear connection system was tested in order to be used in off-site manufactured cassette floor elements made with glulam beams and cross laminated timber (CLT) panels. This type of floor element can present advantages from weight, structural and assembly point of view in multi-storey timber construction. The shear connection proposed is made of double-sided punched metal plate fasteners, connecting CLT and glulam members to form a T-cross-section. Inclined screws are used in combination with the double-sided nail plates to secure the shear connection. Shear test results are presented and compared with a simple calculation model for estimating the mean load-carrying capacity and stiffness of the combined joint according to methods available in the literature. © 2014 Elsevier Ltd. All rights reserved.",
      "keywords": [
        "CLT",
        "Double-sided punched metal plate fasteners",
        "Glulam",
        "Inclined screws",
        "Shear test",
        "Timber joint"
      ],
