    {
      "id": "web_of_science_1323",
      "title": "Cross-laminated timber flooring and concrete slab flooring: A comparative study of structural design, economic and environmental consequences",
      "authors": "Hassan, Osama A. B. and Oberg, Fredrik and Gezelius, Emil",
      "affiliations": "Linkoping University",
