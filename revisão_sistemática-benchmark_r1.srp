    {
      "id": "scopus_1144",
      "title": "Fire resistance of cross-laminated timber in Japan",
      "authors": "Naruse, Tomohiro and Suzuki, Jun'ichi and Mizukami, Tensei and Yasui, Noboru and Kawai, Makoto and Hasemi, Yuji",
      "affiliations": "Building Research Institute, Tsukuba, Ibaraki, Japan; Japan National Institute for Land and Infrastructure Management, Tsukuba, Ibaraki, Japan; Team Sakura, Tokyo, Japan; Japan Cross Laminated Timber Association, Japan; Waseda University, Tokyo, Japan",
      "countries": [
        "Japan"
      ],
      "journal": "WCTE 2016 - World Conference on Timber Engineering",
      "year": 2016,
      "score": 38,
      "abstract": "Fire-testing data, such as charring rates and failure modes of structural elements exposed to ISO-standard fires, for unprotected cross-laminated timber (CLT) panels made of domestic timber were investigated to apply the reduced-cross-section method to CLT panels. For the charring rates, a series of fire tests without loading was conducted with experimental parameters including adhesive type, lamina thickness, and wood species. Based on the measured charring rates, a series of fire-resistance tests for loadbearing walls, floors, and roofs using unprotected CLT panels exposed to ISO-standard fires was conducted to investigate fire resistance in terms of loadbearing capacity, integrity, and insulation. Fire-resistance test for a CLT floor-wall-floor-wall structure with tension bolts and self-tapping screws was also tested to investigate the insulation and integrity of joints under loading. This paper summarizes the results of these tests.",
      "keywords": [
        "Charring rate",
        "Cross-laminated timber",
        "Fire resistance",
        "Reduced-cross-section method"
      ],
      "studyType": "Conference paper",
      "quality": null,
