        {
          "id": "scopus_1129",
          "title": "Structural redundancy in cross-laminated timber buildings",
          "authors": "Lukacs, Ildiko and Björnfot, Anders and Tsalkatidis, Themistoklis S. and Tomasi, Roberto",
          "affiliations": "Norges Miljø- og Biovitenskapelige Universitet, As, Viken, Norway",
          "countries": [
            "Norway"
          ],
          "journal": "WCTE 2016 - World Conference on Timber Engineering",
          "year": 2016,
          "score": 21,
          "abstract": "In high timber structures, cross-laminated timber panels are common structural elements. The wall and floor panels are typically connected with steel plates, angle brackets, hold-downs, and screws. Based on analytical research, it seems that panel-to-panel connections give additional stiffness due to structural redundancies resulting from transversal wall and floor elements. The purpose of this paper is to investigate the effect of structural redundancy of common CLT wall-to-floor panel configurations on the global system stiffness. As a first phase, a Finite Element (FE) study is performed to investigate the behavior of a single shear panel subjected to both horizontal and vertical loads. In this paper, the behavior of the FE model is verified with previous tests results of CLT shear walls. The next phase presented in the paper outlines future work of a Finite Element study with different CLT wall configurations with longitudinal and transversal CLT panels connected to each other.",
          "keywords": [
            "Cross-laminated timber (CLT)",
            "FE modelling",
            "Steel connection",
            "Structural redundancy",
            "System stiffness",
            "Timber shear-walls"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": null,
          "language": "English",
          "source": "Scopus",
          "numString": 2,
