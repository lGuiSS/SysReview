        {
          "id": "scopus_339",
          "title": "NUMERICAL SEISMIC ANALYSES OF MULTI-STOREY CLT STRUCTURES WITH HIGH-PERFORMANCE CONNECTIONS",
          "authors": "Smiroldo, Francesco and Gaspari, Andrea and Viel, D. and Borsati, E. and Giongo, Ivan",
