        {
          "id": "scopus_484",
          "title": "A Comparison of Punching Shear Design Approaches for Point Supported CLT Panels",
          "authors": "Slotboom, Christian and Dickof, Carla and Jackson, Robert",
          "affiliations": "Fast+Epp, Seattle, WA, United States",
          "countries": [
            "United States"
          ],
          "journal": "13th World Conference on Timber Engineering, WCTE 2023",
          "year": 2023,
          "score": 15,
          "abstract": "The following study examines different methods of punching shear design for point supported Cross Laminated timber (CLT) panels. A literature review was completed, summarizing CLT rolling shear capacity, as determined in both European and North America research as well as code and material standard documents. Analysis methods for calculating internal stresses in CLT slabs were then reviewed, with an emphasis on simplified design equations. Several design checks were then completed by comparing predicted capacity to tested strength for CLT panels from existing experimental programs. Predictions from each method were compared to actual panel capacities from testing, and it was found the methods used predicted failure at approximately 3x the input load or higher for the specific panel examined. A parametric study was completed where a number of panels were analysed using the different analysis methods outlined. The parameters studied include panel number of spans, length, width, grade, thickness, and support size. It was shown that simplified analysis methods make predictions that were comparable to FEM predictions, but FEM results varied more with respect to these parameters. It was also shown that the support stiffness was a significant parameter on the distribution of shear forces and the peak model forces observed. © 13th World Conference on Timber Engineering, WCTE 2023. All rights reserved.",
          "keywords": [
            "CLT Floors",
            "Point-supported floors",
            "Punching Shear",
            "Rolling Shear",
            "Tall wood buildings",
            "two-way floor action"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": "10.52202/069179-0349",
          "language": "English",
