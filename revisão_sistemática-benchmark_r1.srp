        {
          "id": "scopus_867",
          "title": "Effects of mechanical uncertainties on dynamic properties of cross-laminated timber floors",
          "authors": "Milojević, Marija and Nefovska-Danilović, Marija T. and Živanović, Stana and Marjanović, Miroslav S.",
          "affiliations": "University of Belgrade, Faculty of Civil Engineering, Belgrade, Serbia; University of Exeter, Mathematics and Physical Sciences, Exeter, Devon, United Kingdom",
          "countries": [
            "Serbia",
            "United Kingdom"
          ],
          "journal": "Proceedings of the International Conference on Structural Dynamic , EURODYN",
          "year": 2020,
          "score": 8,
          "abstract": "This paper investigates the effects of material properties (mass density, elastic and shear moduli) on dynamic properties of simply-supported CLT floors (natural frequencies, mode shapes and modal mass). Uncertainty quantification analysis has been carried out based on Monte Carlo simulations by varying material properties. Numerical modelling and analysis of the investigated CLT floors has been performed using finite element models in Abaqus CAE. The results show that uncertain mechanical parameters having significant influence on the dynamic properties are mass density, elastic modulus EL, and shear moduli GLT and GRT, where L, T and R denote longitudinal, tangential and radial direction, respectively. © 2020 European Association for Structural Dynamics. All rights reserved.",
          "keywords": [
            "CLT floors",
            "Dynamic properties",
            "Finite element modeling",
            "Monte Carlo simulation",
            "Uncertainty quantification"
          ],
