    {
      "id": "scopus_1118",
      "title": "A contribution to the design of ribbed plates",
      "authors": "Augustin, Manfred and Zimmer, Severin E. and Bogensperger, Thomas and Sleik, Tim",
      "affiliations": "holz.bau forschungs gmbh, Graz, Styria, Austria; Binderholz Bausysteme GmbH, Hallein, Austria",
      "countries": [
        "Austria"
      ],
      "journal": "WCTE 2016 - World Conference on Timber Engineering",
      "year": 2016,
      "score": 23,
      "abstract": "The topic of this paper is the discussion of a proposal for the design of ribbed plates built-up with CLT (plate)- and GLT (ribs)-members. The suggested elastic model is based on the work of Abdelouahed.",
      "keywords": [
