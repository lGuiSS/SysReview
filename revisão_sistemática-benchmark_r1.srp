    {
      "id": "scopus_364",
      "title": "Short-Term Bending Test of Prestressed CLT-Concrete Composite Panels",
      "authors": "Bajzecerová, Viktória and Kanócz, Ján",
      "affiliations": "Technická Univerzita v Košiciach, Institute of Structural Engineering, Kosice, Kosice Region, Slovakia; Technická Univerzita v Košiciach, Department of Architecture, Kosice, Kosice Region, Slovakia",
      "countries": [
        "Slovakia"
      ],
      "journal": "AIP Conference Proceedings",
      "year": 2023,
      "score": 35,
      "abstract": "An adhesive shear connection of timber and concrete enables the production of a composite structure with relatively high bending resistance. A wet method of glueing allows fresh concrete and mass timber slabs with a not ideally planar or a curved surface to connect. In this method, the shrinkage of concrete negatively impacts the long-term behaviour of composite panels and causes relatively high deflection. This negative effect was eliminated in the production of prestressed CLT-concrete composite panels using a high initial camber of CLT slab before concreting and shear connecting with the concrete slab. The camber values were at the level of 1/100 of span. This paper presents the results of a short-term bending test of two prestressed CLT-concrete composite panels. The test was performed one year after concreting. The results confirmed the presumption that by prestressing the panels, it is possible to achieve higher load-bearing capacity compared to the load capacities of non-prestressed panels. © 2023 American Institute of Physics Inc.. All rights reserved.",
      "keywords": [],
      "studyType": "Conference paper",
      "quality": null,
      "doi": "10.1063/5.0181206",
      "language": "English",
      "source": "Scopus",
