    {
      "id": "scopus_1054",
      "title": "Floor impact sound insulation performance of CLT floor slab and reduction effect by floor coverings",
      "authors": "Tanaka, Manabu and Murakami, Tsuyoshi and Kasai, Yusuke and Kawai, Makoto",
      "affiliations": "General Building Research Corporation of Japan, Building Environment Dept., Suita, Osaka, Japan; Japan Cross Laminated Timber Association, Japan",
      "countries": [
        "Japan"
      ],
      "journal": "AIJ Journal of Technology and Design",
      "year": 2017,
      "score": 104,
      "abstract": "The purpose of this study is to estimate the floor impact sound insulation performance of floor slabs with cross laminated timber panels (=CLT panels) and to grasp the reduction effect by floor coverings. Results of experiments in the laboratory show that the performance of CLT floor slabs is lower than that of a RC slab and a wood-frame panel construction floor slab concerning the light floor impact. Carpets and sound insulation floorings are found to be effective to light floor impact sound insulation. Resiliently-supported double floors seem effective to both light and heavy floor impact sound insulation.",
      "keywords": [
        "Cross laminated timber",
        "Floor coverings",
        "Floor impact sound insulation performance",
        "Reduction effect"
      ],
      "studyType": "Article",
      "quality": null,
