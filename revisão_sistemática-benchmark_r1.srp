        {
          "id": "web_of_science_2116",
          "title": "Enhancement of the out-of-plane bending performance of CLT panels using CFRP reinforcement",
          "authors": "Bravo, Tomas P. and Beltran, Juan Felipe and Maluk, Cristian and Gattas, Joseph M.",
          "affiliations": "University of Queensland; Universidad de Chile",
          "countries": [
            "Chile"
          ],
          "journal": "ENGINEERING STRUCTURES",
          "year": 2025,
          "score": 60,
          "abstract": "This paper investigates the capacity for carbon fibre-reinforced polymer (CFRP) composites to enhance the flexural stiffness, strength, and ductility of cross-laminated timber (CLT) panels. The research focuses on identifying key governing factors in an observed transition from brittle tensile fracture in unreinforced CLT panels to pseudo-ductile tensile and ductile compressive failures in reinforced CLT panels. Experimental bending tests were conducted on 27 three-ply CLT panels with varying reinforcement ratios (0.0\\%, 0.3\\%, and 0.6\\%) and thicknesses (115, 125, and 135 mm) in a four-point bending setup. Results indicate that CFRP reinforcement leads to substantial improvements in the structural performance of CLT panels, with strength increasing by up to 37\\% and stiffness by up to 27\\%. Ductility was also enhanced with reinforcement, from average values of 1.0 (brittle failure) to more than 1.9 and 2.8 for displacement and energy ductility, respectively. An analytical cross-sectional model was developed to predict panel bending strength and stiffness, accounting for the neutral axis shift due to FRP reinforcement. The model also accurately predicts brittle tensile or ductile compressive failure modes based on the effective ultimate tensile strain of timber without or with CFRP reinforcement. Results from this paper demonstrate the significant potential for CFRP to enhance timber member ductility with reliable predictive performance modelling.",
          "keywords": [
            "Cross-laminated timber",
            "Near-surface mounted reinforcement",
            "Fibre-reinforced polymers",
            "Bending performance",
            "Ductility",
            "Cross-sectional analysis"
          ],
          "studyType": "Article",
          "quality": null,
          "doi": "10.1016/j.engstruct.2025.120653",
          "language": "English",
          "source": "Web of Science",
          "numString": 6,
