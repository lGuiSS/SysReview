        {
          "id": "scopus_276",
          "title": "The Albizzia Tower",
          "authors": "Hardel, Mathurin and Le Bihan, Cyrille and Gambatesa, Leonardo and Baugé, Antoine",
          "affiliations": "HARDEL LE BIHAN ARCHITECTES, Paris, France; SYLVA CONSEIL, Paris, France",
          "countries": [
            "France"
          ],
          "journal": "International Journal of High-Rise Buildings",
          "year": 2024,
          "score": 4,
          "abstract": "The 53-meter tall Albizzia Tower is a white, mineral building with a mixed concrete and wood structure. It harmoniously interacts with the high rises of La Confluence. Its base is largely open, in direct relation to the public space. The spaces are mutable, reversible, moldable thanks to a streamlined structure: posts, beams in glued laminated wood, with posts pushed back on the facade to facilitate the layout of office and housing floors, CLT floors with a span of 7 meters. © (2024), (Korean Council on Tall Buildings and Urban Habitat). All rights reserved.",
          "keywords": [
            "CLT",
            "fire safety in timber frame",
            "innovative concrete façade",
            "prefabrication",
            "timber tower",
            "ultra-high-performance fiber-reinforced concrete"
          ],
