    {
      "id": "scopus_732",
      "title": "Shear slip behavior of composite cross laminated timber concrete panels with self-tapping screw anchors",
      "authors": "Judd, Johnn P. and Fonseca, Fernando S. and LeBaron, Jeffery and Closen, Maximilian",
      "affiliations": "Brigham Young University, Provo, UT, United States; MTC Solutions, Montreal, QC, Canada",
      "countries": [
        "United States",
        "Canada"
      ],
      "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
      "year": 2021,
      "score": 29,
      "abstract": "Shear tests were conducted to determine the slip behavior of composite cross laminated timber (CLT) concrete floors with self-tapping screw anchors. The study examined four screw configurations (inclined, crossed, nested, and normal to the CLT panel surface), three wood materials (Douglas fir, Hem fir, and spruce pine fir), and two panel orientations (strong-axis and weak-axis). The tests were conducted on coupon specimens of composite CLT-concrete panels. The specimens were subjected to a half cyclic loading protocol in which an initial load was applied and then released to eliminate the effect of connection seating. The load was then applied until the specimens failed. The results showed that the inclined configuration provided the largest shear strength compared to the normal, crossed, and nested screw configurations; nevertheless, all configurations provided a ductile failure mechanism. On average, an increased specific gravity of the wood material led to increased initial stiffness and strength, while the weak-axis orientation led to decreased strength and stiffness. © WCTE 2021. All rights reserved.",
      "keywords": [
        "Composite construction",
        "Cross laminated timber",
        "Mechanical fasteners"
      ],
      "studyType": "Conference paper",
      "quality": null,
      "doi": null,
      "language": "English",
