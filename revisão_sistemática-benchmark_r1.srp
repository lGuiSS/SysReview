    {
      "id": "scopus_762",
      "title": "Comparative study of thermal properties of timber",
      "authors": "Liu, Julie and Fischer, Erica C.",
      "affiliations": "Oregon State University, School of Civil and Construction Engineering, Corvallis, OR, United States",
      "countries": [
        "United States"
      ],
      "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
      "year": 2021,
      "score": 3,
      "abstract": "Previous researchers have developed thermal models for temperature-dependent timber thermal properties. However, the impact of these models on simulating heat transfer through timber cross sections has not been quantified in terms of the resulting calculated temperatures. In this paper, four different models of temperature-dependent thermal conductivity, specific heat, and density ratio developed for sawn lumber were utilized in finite element heat transfer analyses of sawn lumber, cross-laminated timber, and timber-concrete composite floors exposed to the standard fire curve. The simulated temperatures were quantitatively compared to experimentally measured temperatures through cross sections of different timber elements. This study identified the models that were in best agreement with experimental data from the literature based on comparison of their root mean square deviation. © WCTE 2021. All rights reserved.",
      "keywords": [
        "Finite element modelling",
        "Fire",
        "Heat transfer",
        "Mass timber"
      ],
      "studyType": "Conference paper",
      "quality": null,
