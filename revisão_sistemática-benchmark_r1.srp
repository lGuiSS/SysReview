      "fullText": null
    },
    {
      "id": "web_of_science_2136",
      "title": "Experimental determination of the equivalent-layer shear stiffness of CLT through four-point bending of sandwich beams",
      "authors": "Perret, Olivier and Lebee, Arthur and Douthe, Cyril and Sab, Karam",
      "affiliations": "Universite Gustave-Eiffel; Institut Polytechnique de Paris; Ecole Nationale des Ponts et Chaussees; Centre National de la Recherche Scientifique (CNRS); CNRS - Institute for Engineering \\& Systems Sciences (INSIS)",
      "countries": [],
      "journal": "CONSTRUCTION AND BUILDING MATERIALS",
      "year": 2018,
      "score": 58,
      "abstract": "In this paper, a new methodology for the experimental determination of the CLT equivalent cross-layer shear elastic modulus is suggested using a wooden core sandwich beam with Carbon Fiber Reinforced Polymer skins under four-point bending. The stiffness contrast between the wooden layer and the CFRP skins ensures that the bending stiffness of the sandwich beam is mostly driven by the CFRP skins and the shear force stiffness of the beam is mostly driven by the shear modulus of the wooden core. Several measurements for the determination of the bending stiffness of the sandwich beam are investigated. Particularly, it is shown that the suggested measurement of the bending stiffness from rotation at beam ends presents more reliable results than common measurements of curvature. Then the results of a preliminary experimental study are presented using this set-up and promising results are obtained: the equivalent cross-layer shear modulus is measured at 124 MPa which lies well within literature. (C) 2018 Elsevier Ltd. All rights reserved.",
      "keywords": [
        "Cross Laminated Timber",
        "Rolling-shear modulus",
        "Equivalent cross-layer behavior",
        "Sandwich beam",
        "Four-point bending"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1016/j.conbuildmat.2018.07.102",
      "language": "English",
      "source": "Web of Science",
      "numString": 6,
      "isDuplicate": true,
      "duplicateOf": "scopus_2070",
      "dataProcessingStatus": "duplicate",
      "filter1Status": "pending",
      "filter2Status": "pending",
      "filter3Status": "pending",
      "extractionCriteria": null,
      "searchString": "( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( bending OR flexural ) AND ( reinforced OR reinforcement OR FRP OR FRC OR CFRP)",
      "importDate": "2026-02-23T22:37:55.212Z",
      "lastModified": "2026-02-23T22:37:55.212Z",
      "idData": 4,
