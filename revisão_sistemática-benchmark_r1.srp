        {
          "id": "scopus_317",
          "title": "Vibration serviceability assessment of complex-shaped CLT floor",
          "authors": "Milojević, Marija and Racic, Vitomir and Marjanović, Miroslav S. and Nefovska-Danilović, Marija T.",
          "affiliations": "University of Belgrade, Faculty of Civil Engineering, Belgrade, Serbia",
          "countries": [
            "Serbia"
          ],
          "journal": "Journal of Physics: Conference Series",
          "year": 2024,
          "score": 22,
          "abstract": "Cross-laminated timber (CLT) floors are typically an assembly of prefabricated panels connected together on the site. CLT offers a wide range of configuration possibilities, as it can be easily pre-cut into various shapes and sizes, making it suitable for use in different architectural design requirements. However, available CLT design guidelines do not apply to complex-shaped CLT floors, i.e. unconventional geometry of floor plans including concave polygons, arches and openings. This paper presents a numerical vibration analysis of such a floor with openings, which represents a standard floor structure for residential and commercial buildings. Influence of panel orientation and inter-panel connections on modal properties and vibration response induced by a single pedestrian walking is analysed and discussed. © Published under licence by IOP Publishing Ltd.",
          "keywords": [
            "Floors",
            "Office buildings",
            "Concave polygons",
            "Cross laminated",
            "Floorplans",
            "Laminated timber",
            "Prefabricated panel",
            "Serviceability assessment",
            "Shape and size",
            "Timber design",
            "Timber floors",
            "Vibration serviceability",
            "Vibration analysis"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": "10.1088/1742-6596/2647/13/132002",
          "language": "English",
