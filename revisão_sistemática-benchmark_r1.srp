          "filter1Status": "pending",
          "filter2Status": "pending",
          "filter3Status": "pending",
          "exclusionReason": null,
          "inclusionCriterion": null,
          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:37:03.852Z",
          "lastModified": "2026-02-23T22:37:03.852Z"
        },
        {
          "id": "web_of_science_1654",
          "title": "Schema for Automated Generation of CLT Framing and Panelization",
          "authors": "Bermek, Mehmet Sinan and Shelden, Dennis and Gentry, Russell",
          "affiliations": "University System of Georgia; Georgia Institute of Technology",
          "countries": [
            "Georgia"
          ],
          "journal": "COMPUTING IN CIVIL ENGINEERING 2019: VISUALIZATION, INFORMATION MODELING, AND SIMULATION",
          "year": 2019,
          "score": 19,
          "abstract": "Representing a new generation of mass timber products, intended for commercial construction, cross laminated timber ( CLT) panels are a reliable, cost effective material for mid-rise construction due to their physical characteristics and suitability to pre-fabrication. These qualities combined with the maturing North American forestry stock have prompted an increasing use of CLT in the U.S. AEC industry. However there is no established framework to support the information requirements for CLT building systems, to permit highly automated industrial production. Our research focuses on developing a data schema for streamlining information flows and coordination in different stages of design, manufacturing, and assembly of buildings using CLT. The framework is demonstrated for CLT floor systems, and shows the adaptability of the schema for different support configurations. In the proposed system, the floor framing adapts to global geometry. Finally, an automated system for panel edges, based on the overall framing logic, is proposed.",
          "keywords": [],
          "studyType": "Proceedings Paper",
          "quality": null,
          "doi": null,
          "language": "English",
          "source": "Web of Science",
          "numString": 3,
          "isDuplicate": false,
