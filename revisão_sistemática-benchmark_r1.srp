        {
          "id": "scopus_741",
          "title": "The first mass timber building in Brazil",
          "authors": "Calil Neto, Carlito and Takata, Alexander and Negreli, Murilo and de Lima, Luiz Couto",
          "affiliations": "Rewood - Structural Timber Solutions, Sao Paulo, Brazil",
          "countries": [
            "Brazil"
          ],
          "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
          "year": 2021,
          "score": 5,
          "abstract": "The use of new technologies in wood for construction is increasing every year in Brazil. “Dengo” is the first commercial building to use wood for it's structure and interior. It's a 4 storey Glulam post and beam frame with CLT floors panels and a mix of CLT and Wood-frame Walls. This study aims to demonstrate step by step the entire building system that was used for the construction of the first mass timber building in Brazil located in one of the main avenues of São Paulo city. © WCTE 2021. All rights reserved.",
          "keywords": [
