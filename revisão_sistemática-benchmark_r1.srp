        {
          "id": "web_of_science_2186",
          "title": "A COMPUTATIONAL ANALYSIS OF THE ENERGY HARVESTED BY GFRP AND NFRP LAMINATED BEAMS UNDER CYCLIC LOADING",
          "authors": "Fragoudakis, Roselita and Gallagher, John A. and Kim, Vladimir",
          "affiliations": "Merrimack College",
          "countries": [],
          "journal": "3RD INTERNATIONAL CONFERENCE ON NATURAL FIBERS: ADVANCED MATERIALS FOR A GREENER WORLD, ICNF 2017",
          "year": 2017,
          "score": 11,
          "abstract": "This paper investigates the possibility of energy harvesting using Fiber Reinforced Plastic beams under cyclic loading. The behaviour of E-glass fiber/epoxy and Hemp fiber/epoxy laminated beams reinforced with piezoelectric fibers is examined by evaluating their bending strain and deflection. An optimum stacking sequence for all types of reinforcement: E-glass fibers, hemp fibers, and piezoelectric fibers, is suggested such that energy harvesting potential is maximized while failure and damage accumulation remain at low levels.",
          "keywords": [
