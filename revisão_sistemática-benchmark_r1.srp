        {
          "id": "web_of_science_1575",
          "title": "Characterization of inter-panel connections in CLT floors using finite element model updating",
          "authors": "Milojevic, Marija and Racic, Vitomir and Nefovska-Danilovic, Marija and Ereiz, Suzana and Duvnjak, Ivan",
          "affiliations": "University of Belgrade; University of Zagreb",
          "countries": [],
          "journal": "JOURNAL OF BUILDING ENGINEERING",
          "year": 2024,
          "score": 13,
          "abstract": "Large cross-laminated timber (CLT) floors are inevitably composed of multiple CLT panels assembled on the construction site. Due to the sheer lack of adequate numerical characterization of the inter-panel connections, CLT floors are normally modelled as monolithic structures or independent ``piano keyboards''",
