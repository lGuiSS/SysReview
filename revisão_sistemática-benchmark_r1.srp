        {
          "id": "scopus_1046",
          "title": "Moisture response of a full-scale cross laminated timber panel during environmental simulation: Key factors in design and management",
          "authors": "Schmidt, Evan L. and Riggio, Mariapaola and Barbosa, Andre R. and Mugabo, Ignace and Laleicke, Paul Frederik",
          "affiliations": "Oregon State University, Department of Wood Science and Engineering, Corvallis, OR, United States; Oregon State University, Department of Civil Engineering, Corvallis, OR, United States",
