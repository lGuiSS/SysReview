          "exclusionReason": null,
          "inclusionCriterion": null,
          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:37:03.839Z",
          "lastModified": "2026-02-23T22:37:03.839Z"
        },
        {
          "id": "web_of_science_1555",
          "title": "Experimental Investigation and Design Equations for Steel Strap Connections in CLT Construction",
          "authors": "Tran, Dang Khai and Jeong, Gi Young",
          "affiliations": "Chonnam National University",
          "countries": [],
          "journal": "JOURNAL OF MATERIALS IN CIVIL ENGINEERING",
          "year": 2026,
          "score": 17,
          "abstract": "Steel strap connections are widely used in mass timber buildings. Therefore, accurately predicting their tensile behaviors and properties is crucial for the structural design of cross-laminated timber (CLT) systems. The goal of this study is to investigate the tensile properties of steel strap connections in wall-to-wall and floor-to-floor applications. The effects of different wood species, number of screws, screw spacing, construction type, and loading protocols on the tensile behaviors of the steel strap connections on CLT were investigated. Results showed that increasing the number of screws (from 6 to 12) significantly enhanced tensile resistance by up to 75\\%, and greater screw spacing (60 to 200 mm) strongly influenced stiffness and deformation capacity. The failure behaviors of the steel strap connection varied according to the wood species, number of screws, and screw spacing. Based on the findings, design guidelines are proposed for selecting appropriate connection configurations to resist uplift forces in CLT construction. The proposed prediction models showed good agreement with the experimental results, with average differences of 7.0\\% for stiffness, 18.1\\% for tensile resistance, and 3.9\\% for the ductility ratio.",
          "keywords": [
            "Steel strap",
            "Connection",
            "Cross-laminated timber (CLT)",
            "Hold-down",
            "Angle bracket",
            "Metal plate"
          ],
          "studyType": "Article",
          "quality": null,
          "doi": "10.1061/JMCEE7.MTENG-20640",
          "language": "English",
          "source": "Web of Science",
          "numString": 3,
          "isDuplicate": false,
          "duplicateOf": null,
