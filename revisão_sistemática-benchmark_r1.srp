        {
          "id": "web_of_science_1374",
          "title": "Axially loaded screws in solid timber, glued laminated timber and cross laminated timber",
          "authors": "Ringhofer, Andreas and Brandner, Reinhard and Flatscher, Georg and Schickhofer, Gerhard",
          "affiliations": "Graz University of Technology",
          "countries": [],
          "journal": "Bautechnik",
          "year": 2015,
          "score": 11,
          "abstract": "This paper concentrates on the bearing behavior of axially loaded self-tapping screws in solid timber and the board-composed, layered timber products glued laminated timber and cross laminated timber. Focusing on withdrawal failure mode and basing on numerous investigations done in the past, we formulate a new and universal approach including multiplicative k-factors or k-functions for determining the withdrawal strength of self-tapping screws variably situated in these products. Consequently, we verify the new model with results gained from several test series related, approaches given in the literature and test results of CLT-wall-to-floor and -wall-to-wall connections. Finally, we determine, discuss and verify a characteristic function provided for practical application.",
          "keywords": [
            "self-tapping screws",
            "axial loading",
            "withdrawal",
            "solid timber (ST)",
            "glued laminated timber (GLT)",
            "cross laminated timber (CLT)",
