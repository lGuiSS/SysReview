        {
          "id": "scopus_501",
          "title": "NUMERICAL AND EXPERIMENTAL INVESTIGATIONS ON THE STRESS STATE OF CLT-PLATES NEAR CONCENTRATED LOADS",
          "authors": "Wimmer, Heinz and Huber, Christoph and Eder, Robert",
          "affiliations": "MPT Engineering GmbH, Steyregg, Austria; Fachhochschule Kärnten, Spittal an der Drau, Carinthia, Austria; University of Applied Sciences Upper Austria, School of Engineering, Wels, Upper Austria, Austria; KASTNER ZT-GmbH (Civil Engineering), Klagenfurt, Austria; Poltnigg & Klammer ZT-GmbH (Civil Engineering), Spittal/Drau, Austria",
          "countries": [
            "Austria"
          ],
          "journal": "13th World Conference on Timber Engineering, WCTE 2023",
          "year": 2023,
          "score": 18,
          "abstract": "Cross laminated timber (CLT), as a structural plate-like timber product has been successfully established in civil engineering practice as a load bearing product for walls, floor and roof elements. In a bending situation with transverse shear the cross section does not remain in a plane form due to the strong flexibility of crossing layers. The deformed cross section shows a significant warping which follows a zigzag pattern that influences the stress state. Comparative studies are worked out to investigate the efficiency of two different structural theories. It turned out, that the traditionally used First Order Shear Deformation Theory (FSDT) does not reflect satisfactorily the local stress state near concentrated loads. It is demonstrated that the relatively new Refined Zigzag Theory (RZT) is much better able to represent the stresses in different layers of CLT-plates in such a case. In particular, the rolling shear stress and the maximum bending stress will be strongly underestimated by FSDT, while RZT will provide accurate results. This finding was confirmed by alternative analysis with high-resolution FE continuum elements and by experimental tests using linear strain gauges and a digital image correlation system (DIC) to record the deformations in the area of interest. © WCTE 2023.All rights reserved",
          "keywords": [
            "Concentrated load",
            "Cross Laminated Timber",
            "Digital image correlation (DIC)",
            "First Order Shear Deformation Theory",
            "Refined Zigzag Theory",
            "Rolling shear stress",
            "Stress state"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": "10.52202/069179-0334",
          "language": "English",
          "source": "Scopus",
          "numString": 2,
          "isDuplicate": false,
          "duplicateOf": null,
          "dataProcessingStatus": "pending",
          "filter1Status": "pending",
          "filter2Status": "pending",
          "filter3Status": "pending",
          "exclusionReason": null,
          "inclusionCriterion": null,
          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:36:58.057Z",
          "lastModified": "2026-02-23T22:36:58.057Z"
        },
        {
          "id": "scopus_502",
          "title": "ANALYSIS OF DIFFERENT NUMERICAL MODELLING STRATEGIES OF MULTI-STOREY CLT SHEAR WALLS",
          "authors": "Ruggeri, Elisabetta Maria and D'Arenzo, Giuseppe and Fossetti, Marinella and Seim, Werner",
          "affiliations": "Università degli Studi di Enna",
          "countries": [],
          "journal": "13th World Conference on Timber Engineering, WCTE 2023",
          "year": 2023,
          "score": 16,
          "abstract": "CLT platform-type buildings are characterized by a high level of redundancy due to the high number of connections used in the perimeter of the CLT panels. In this regard, in addition to the connections placed at the base of the walls, other structural components including the floor diaphragms and the lintels above the openings, along with their connections, influence the lateral performances of CLT shear walls. In this paper, an extensive analysis on the lateral behaviour of multi-storey CLT shear walls with openings realized with two different construction techniques is conducted. The study compares the results obtained from a simplified modelling strategy commonly used in practical design with more advanced modelling strategies that consider in detail the effects of structural interactions between floors and wall segments and between lintels and wall segments. The results of the elastic analyses conducted in this study showed significant differences in the lateral behaviour of systems analysed with the two modelling strategies, emphasizing that the simplified modelling strategies cannot always be reliable methodologies to describe the lateral behaviour of multi-storey CLT shear walls due to the significant effect of structural interactions provided by floors and lintels. © WCTE 2023.All rights reserved",
          "keywords": [
            "CLT structures",
            "Elastic analyses",
            "Multi-storey shear walls",
            "Numerical modelling",
            "Structural interactions"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": "10.52202/069179-0323",
          "language": "English",
          "source": "Scopus",
          "numString": 2,
