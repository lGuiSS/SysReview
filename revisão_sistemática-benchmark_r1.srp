    {
      "id": "scopus_2032",
      "title": "Out-of-plane bending behavior of cross-laminated timber members enhanced with fiber-reinforced polymers",
      "authors": "Li, Hao and Zhang, Qilin and Wei, Yang and Semple, Kate E. and Dai, Chunping",
      "affiliations": "Nanjing Forestry University, College of Civil Engineering, Nanjing, Jiangsu, China; The University of British Columbia, Department of Wood Science, Vancouver, BC, Canada",
      "countries": [
        "China",
        "Canada"
      ],
      "journal": "Journal of Building Engineering",
      "year": 2023,
      "score": 111,
      "abstract": "Carbon or basalt fiber-reinforced polymer (FRP) fabrics were bonded to the bottom of three-layer hemlock cross-laminated timber (CLT), aimed at improving its bending performance under out-of-plane loading. The FRP layer effectively enhanced bending strength by up to 23.8% and global bending stiffness with infinite shear stiffness by up to 18.4%. Carbon FRP was stronger and most effective, and combining it with an inner layer of cheaper basalt FRP also effectively reduced cost. Failure was not observed in the FRP layer, while failure at the transverse layer became more significant. Reinforcement of the transverse layer is therefore recommended to better realize the FRP enhancement effect. A predictive model for bearing capacity in bending for CLT with FRP fabric was developed and validated. Predicted bending stiffness results considering the offset of the neutral axis showed a good agreement with experimental results. The results support the application of FRP fabrics for improved bending performance for CLT panels under out-of-plane loading. © 2023 Elsevier Ltd",
      "keywords": [
        "Bending behavior",
        "Cross-laminated timber",
        "Fiber-reinforced polymer",
        "Predictive model"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1016/j.jobe.2023.105862",
      "language": "English",
      "source": "Scopus",
      "numString": 5,
      "isDuplicate": false,
