        {
          "id": "scopus_1180",
          "title": "Vibroacoustic investigation of light-weight ceilings - Modeling aspects and design guidelines",
          "authors": "Buchschmid, Martin and Kohrmann, Mathias and Müller, Gerhard and Schanda, Ulrich",
          "affiliations": "Technische Universität München, Lehrstuhl für Baumechanik, Munich, Bayern, Germany; Hochschule für angewandte Wissenschaften Rosenheim, Fakultät für angewandte Natur- und Geisteswissenschaften, Rosenheim, Germany",
