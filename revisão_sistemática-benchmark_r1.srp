    {
      "id": "scopus_955",
      "title": "Presentation of example of span table of cross laminated timber floor from the viewpoint of walking vibration",
      "authors": "Koyama, Yuhei and Fukuda, Shintaroh and Yokoyama, Yutaka",
      "affiliations": "Institute of Science Tokyo, Department of Architecture and Building Engineering, Tokyo, Japan",
      "countries": [
        "Japan"
      ],
      "journal": "Journal of Environmental Engineering (Japan)",
      "year": 2019,
      "score": 61,
      "abstract": "Walking vibration can cause complaints on building floor, especially on timber floor. However, its evaluation and estimation method are still not established. In this study, as a first step toward establishing these methods, the vibration characteristics of a CLT floor subjected to walking vibrations was measured. Then, a finite element model was also created to investigate the influence of varying material properties and boundary conditions on the vibration performance of the floor. Then, the influence of CLT floor-wall connection upon vibration characteristics was investigated. In conclusion, the span table of CLT floor from the viewpoint of walking vibration was presented. © 2019 Architectural Institute of Japan. All rights reserved.",
      "keywords": [
        "Cross Laminated Timber Floor",
        "Finite Element Method",
        "Habitability",
        "Span Table",
        "Walking Vibration"
      ],
      "studyType": "Article",
