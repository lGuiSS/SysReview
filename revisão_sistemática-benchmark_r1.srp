    {
      "id": "scopus_1122",
      "title": "Stability of Cross laminated Timber (CLT) beams",
      "authors": "Krenn, Harald and Moosbrugger, Thomas and Bogensperger, Thomas",
      "affiliations": "KLH Massivholz GmbH, Teufenbach-Katsch, Austria; Rubner Holding AG, Kiens, Italy; holz.bau forschungs gmbh, Graz, Styria, Austria",
      "countries": [
        "Austria",
        "Italy"
      ],
      "journal": "WCTE 2016 - World Conference on Timber Engineering",
      "year": 2016,
      "score": 36,
      "abstract": "Cross laminated Timber (CLT) is commonly used as load-carrying, planar structural element for roofs, floors and walls. Most frequently it can be seen as beam-like structural element. Due to their high geometrical slenderness (h/t<inf>tot</inf>), the stability of CLT elements used as wall-shaped beam over a long span has to be taken into account. Within this paper, the determination of the torsional stiffness of CLT elements will be discussed and the verification process for lateral torsional buckling will be demonstrated on that basis according to ÖNORM B 1995-1-1.",
      "keywords": [
        "CLT",
        "Lateral torsional buckling",
        "Stability",
        "Torsional stiffness",
        "Verification"
      ],
