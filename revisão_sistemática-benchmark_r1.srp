        },
        {
          "id": "scopus_1021",
          "title": "Measurement about walking vibration on Cross Laminated Timber Floor, and presentation of a span table by finite element method",
          "authors": "Koyama, Yuhei and Matsushita, Hitoshi and Fukuda, Shintaroh and Yokoyama, Yutaka",
          "affiliations": "Institute of Science Tokyo, Tokyo, Japan; Takenaka Corporation, Osaka, Osaka, Japan",
          "countries": [
            "Japan"
          ],
          "journal": "WCTE 2018 - World Conference on Timber Engineering",
          "year": 2018,
          "score": 25,
          "abstract": "In recent years in Japan, the structural design system of Cross Laminated Timber (CLT) is being developed. However, the habitability of a CLT building, particularly for vibrations generated from footfall, is still not completely understood. There are some criteria for floor vibration of timber floor overseas. However, there is no criterion about vibration in Japan. In this study, the vibration characteristics of a domestic CLT floor subjected to walking vibrations was measured and compared to sensory test evaluations. Using this result, a finite element model was also made to investigate the influence of varying material properties and boundary conditions on the vibration performance of the floor. Through analytical modeling based on these results, the span table for CLT floors based on the unpleasantness of walking vibration was presented. © WCTE 2018 Committee.",
          "keywords": [
            "CLT",
            "FEM",
            "Sensory test",
            "Span table",
            "VLT",
            "Walking vibration"
          ],
