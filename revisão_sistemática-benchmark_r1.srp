    {
      "id": "scopus_754",
      "title": "Development of wooden flat slab structure by CLT laminated assembly floor and timber assembly columns ～full-scale horizontal loading experiment of fishboneshaped wooden flat slab structure composed of CLT panels and timber assembly columns～",
      "authors": "Kajikawa, Hisamitsu and Kikuchi, Ei and Ogawa, Haruhiko",
      "affiliations": "Meiji University, Department of Architecture, Tokyo, Japan; Misawa Homes Institute of Research and Development Co., Ltd., Tokyo, Japan",
      "countries": [
        "Japan"
      ],
      "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
      "year": 2021,
      "score": 73,
      "abstract": "In order to determine the best use of CLT in Japan, a wooden flat slab structure was developed using CLT laminated assembly floors and timber assembly columns for medium- to large-scale buildings. Horizontal loading experiments were conducted on a two-story fishbone model consisting of CLT panels and timber assembly columns to experimentally determine the kinematical properties of the wooden flat slab structure. Finally, a review of the structural analysis of the wooden flat slab structure was conducted. © WCTE 2021. All rights reserved.",
      "keywords": [
