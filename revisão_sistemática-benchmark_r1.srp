        {
          "id": "scopus_1241",
          "title": "Wall-slab interaction of multi-storey timber buildings under earthquake impact",
          "authors": "Hummel, Johannes and Seim, Werner",
          "affiliations": "Universität Kassel, Timber Structures and Building Rehabilitation, Kassel, Hessen, Germany",
          "countries": [
            "Germany"
          ],
          "journal": "World Conference on Timber Engineering 2012, WCTE 2012",
          "year": 2012,
          "score": 7,
          "abstract": "This paper presents the main results of a case study on multi-storey buildings under earthquake impact. The objectives were to investigate the influence of connection flexibilities with calculation methods as used by engineers in practice and to find out capabilities and limitations of these methods. Moreover, the paper will illustrate the dynamic behaviour of multi-storey timber structures in combination with a concrete core. Timber framed constructions and cross laminated timber are considered for wall and slab structures.",
