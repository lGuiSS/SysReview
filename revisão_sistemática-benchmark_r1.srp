        {
          "id": "scopus_128",
          "title": "Waste Utilization Panels - Design optimization for geometry, structure and material in mass plywood panels additively constructed from offcuts",
          "authors": "Lawrie, Braden and Wood, Dylan Marx and Mayencourt, Paul and Fischer, Erica C.",
          "affiliations": "University of Oregon, School of Architecture, Eugene, OR, United States; University of Oregon, School of Architecture and Environment, Eugene, OR, United States; Department of Environmental Science, Policy, and Management, Berkeley, CA, United States; College of Engineering, Corvallis, OR, United States",
          "countries": [
            "United States"
          ],
          "journal": "Proceedings from the 14th World Conference on Timber Engineering: Advancing Timber for the Future Built Environment, WCTE 2025",
          "year": 2025,
          "score": 5,
          "abstract": "Mass Timber panels represent a growing sustainable design and structural alternative to steel and concrete as both floor and wall systems. However, mass timber panels made from cross-laminated timber or mass plywood panels, are typically produced in standardized rectilinear volumes with continuous thickness due to both design and manufacturing constraints, resulting in excess material compared to the structural needs of the panel. In this research, we propose an additive approach to designing and optimizing the use of fiber and material volume in a mass plywood panel constructed from thin base panels combined with rectilinear offcut remnant material. A parametric shaping model with simple fabrication constraints is combined with structural optimization to determine the best material placement, adding depth and directionality to the thin plate. Preliminary results in the design phase show a dramatic reduction in material can be achieved by utilizing an existing typology of linear offcuts. Structural testing is planned to verify the stiffness of the geometrically optimized panels. © (2025) WORLD CONFERENCE ON TIMBER ENGINEERING 2025 (WCTE 2025) All rights reserved.",
          "keywords": [
            "cross laminated timber",
            "mass plywood panels",
            "material efficiency",
            "shape optimization",
            "upcycling"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": "10.52202/080513-0518",
          "language": "English",
