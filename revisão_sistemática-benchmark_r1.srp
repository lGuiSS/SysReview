    {
      "id": "scopus_773",
      "title": "Case study of a mass timber building in Brazil",
      "authors": "Icimoto, Felipe Hideyoshi and Vairo, Maurizio and Belizário, Ana Carolina and Reydams, Patrick",
      "affiliations": "Amata Company, Brazil",
      "countries": [
        "Brazil"
      ],
      "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
      "year": 2021,
      "score": 10,
      "abstract": "Brazilian civil construction is going through a transformation moment where the prefabrication concept is increasingly present. While tall timber buildings are widely adopted in Europe, it has been gaining popularity in North America and becoming an option in big cities of Brazil. The forestry company AMATA URBEM, which has Pine reforestation in the south of Brazil is building a large-scale engineered timber industry, has been seeking to encourage the Brazilian structural timber construction market by erecting some mass timber buildings in the city of São Paulo. This paper aims to present a case study of the first building in mass timber with 3 floors in Brazil. The results shows that it is possible to build commercial multi-storey timber buildings in Brazil preparing it for the trends observed in other countries around the world. © WCTE 2021. All rights reserved.",
      "keywords": [
        "CLT",
        "Glulam",
        "Mass timber",
        "Timber construction",
        "Wood Engineered products"
      ],
