    {
      "id": "scopus_724",
      "title": "A comparison of measurement of sound pressure level in timber structures",
      "authors": "Marzi, Arianna and Gasparella, Andrea",
      "affiliations": "Free University of Bozen-Bolzano, Bolzano, BZ, Italy",
      "countries": [
        "Italy"
      ],
      "journal": "2021 Immersive and 3D Audio: From Architecture to Automotive, I3DA 2021",
      "year": 2021,
      "score": 16,
      "abstract": "At present, digital technologies can serve as new tools for acoustic measurements of sound pressure levels, since affordable means such as smartphones are available. In order to understand the accuracy and reliability of measurements using an android application, in this paper we will investigate the comparison between laboratory measurements developed with traditional sound level meters and 4 different mobile phones. The study includes building acoustics tests on a timber cross laminated slab, featuring a floating floor. © 2021 IEEE.",
      "keywords": [
        "CLT",
        "Normalized Impact Sound Pressure Levels",
        "Smartphones",
