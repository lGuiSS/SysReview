    {
      "id": "web_of_science_2122",
      "title": "Bending Performance of Cross-laminated Timber- concrete Composite Slabs According to the Composite Method",
      "authors": "Baek, Seung-Youp and Song, Yo-Jin and Yu, Seok-Hoon and Kim, Dong-Hyeon and Hong, Soon-Il",
