    {
      "id": "scopus_1083",
      "title": "Insulation saving effect for Korean apartment house using cross-laminated timber (CLT)",
      "authors": "Pang, Sung Jun and Lee, Bumjin and Jeong, Gi-young",
      "affiliations": "Chonnam National University, Department of Wood Science and Engineering, Gwangju, South Korea; Chonnam National University, School of Architecture, Gwangju, South Korea",
      "countries": [
        "South Korea"
      ],
      "journal": "Journal of the Korean Wood Science and Technology",
      "year": 2017,
      "score": 60,
      "abstract": "The aim of this study was to develop the details of cross-laminated timber (CLT) envelops for satisfying the design standard for energy saving (DSEA) and passive standard in South Korea. When the same thickness of 180 mm concrete or CLT was used and the same materials for other layers were used for the roof, wall, and interlayer floor, the required insulation thickness for the different building envelopes in central, southern, and Jeju island was evaluated. As a result, compared to the concrete envelop, about 43 mm of insulation thickness was reduced for wall and roof with the CLT envelope. When the CLT envelopes were modified to protect the CLT from moisture based on FPInnovations (2011), the insulation thickness was further reduced by 12 mm. When the modified CLT building envelops satisfied with a passive standard are used for 10-story building, the required insulation was decreased by 40.89 m3 for a floor (105.27 m2 × 2.3 m in height) compared to concrete building. As the number of floors increases, about 3.58 m3 of insulation per floor was additionally saved.",
      "keywords": [
        "Building envelope",
        "Cross-laminated timber",
        "Insulation",
        "Korean-style apartment house"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.5658/WOOD.2017.45.6.846",
