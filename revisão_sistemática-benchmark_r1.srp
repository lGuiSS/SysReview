        },
        {
          "id": "scopus_749",
          "title": "Predicting the strength and serviceability performance of Cross-laminated Timber (CLT) panels fabricated with high-density hardwood",
          "authors": "Crovella, Paul L. and Shahhosseini, Shaghayegh",
          "affiliations": "SUNY College of Environmental Science and Forestry, Syracuse, NY, United States",
          "countries": [
            "United States"
          ],
          "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
          "year": 2021,
          "score": 33,
          "abstract": "The adoption of Cross-laminated Timber (CLT) as a building product has seen exponential growth in Europe, Oceania, and North America during the last decade. However, a challenge to the optimization of CLT in floor systems is the panel's vibration characteristics for out-of-plane loading. This paper presents experimental and numerical investigations on the strength and vibrational serviceability performance of Cross-laminated Timber (CLT) panels fabricated from a relatively high-stiffness, high density species, black locust (Robinia pseudoacacia). To investigate the feasibility of using this hardwood species for fabricating CLT panels, a non-destructive vibration test was conducted to evaluate the serviceability behaviour and a destructive flexural test was performed to evaluate the bending and shear strengths. The experimental vibration analysis was carried out on simply supported beams excited in free vibration to determine the first natural frequency of the beams and compared to the reference values from design guidelines. Third-point and centre-point loadings were used for bending and shear tests, respectively, and strength properties of the beams were compared to predicted values from the Shear Analogy method. The results show that the beams exhibit a significantly higher strength and stiffness but a similar first natural frequency to the theory. Also, the results show that using the softwood species of V2 group reduces the span length by 12.5% from the theoretical value for black locust, and regarding allowable vibration-controlled span length from V2 group softwood species, for the spans lengths over 2.8 m up to 3.2 m, a three-ply floor panel made by a higher density species such as black locust with stronger properties can substitute a four-ply floor panel fabricated from softwood species from V2. © WCTE 2021. All rights reserved.",
          "keywords": [
            "Cross-laminated timber",
            "Flexural and shear test",
            "Floor systems serviceability",
            "High density wood species",
            "Shear analogy method",
            "Vibration test"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": null,
          "language": "English",
          "source": "Scopus",
          "numString": 2,
          "isDuplicate": false,
          "duplicateOf": null,
          "dataProcessingStatus": "pending",
          "filter1Status": "pending",
          "filter2Status": "pending",
          "filter3Status": "pending",
