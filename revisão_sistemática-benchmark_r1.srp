        },
        {
          "id": "web_of_science_1640",
          "title": "On the hygrothermal behavior of coconuts fiber insulators on green roofs",
          "authors": "Fabbri, Kristian and Tronchin, Lamberto and Barbieri, Fabrizio and Merli, Francesca and Manfren, Massimiliano and La Gennusa, Maria and Peri, Giorgia and Cirrincione, Laura and Panzera, Maria Francesca",
          "affiliations": "University of Bologna; University of Southampton; University of Palermo; Universita Mediterranea di Reggio Calabria",
          "countries": [],
          "journal": "2020 20TH IEEE INTERNATIONAL CONFERENCE ON ENVIRONMENT AND ELECTRICAL ENGINEERING AND 2020 4TH IEEE INDUSTRIAL AND COMMERCIAL POWER SYSTEMS EUROPE (EEEIC/I\\&CPS EUROPE)",
