        },
        {
          "id": "scopus_737",
          "title": "Case studies of three architecturally-exposed hybrid CLT-steel roof structures in Canada",
          "authors": "Wong, Jermyn",
          "affiliations": "Associated Engineering Ltd, Edmonton, AB, Canada",
          "countries": [
            "Canada"
          ],
          "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
          "year": 2021,
          "score": 31,
          "abstract": "Cross-laminated timber (CLT) is widely used in exposed roof structures. More often combined with heavy timber framing, CLT can also be used with structural steel to form hybrid systems. This paper presents three project examples. The Kinsmen Park Miniature Train Station in Saskatoon has a CLT roof structure with steel reinforcing members that serve as architectural fascias as well as rain gutters. The Whistler Bus Station comprises CLT on criss-crossing glulam beams, supported at intersecting nodes by steel columns. Each glulam beam has a prefabricated structural steel end piece, which is fully connected to the glulam using proprietary HSK connectors. This end piece is in turn connected to the steel column at the node location. The proposed CLT roof structure of the Lower Seymour Water Services Administration Building in North Vancouver has a folded ridge running diagonally in plan. Whilst the CLT is primarily supported on glulam beams and wood frame walls, the significant two-way overhangs necessitate the use of concealed cantilever steel beams. The beams penetrate the exterior walls to form a backspan, so careful detailing is required to reduce thermal bridging. These three projects illustrate that hybrid CLT-steel structural systems can be practical, efficient, yet aesthetically pleasing. © WCTE 2021. All rights reserved.",
          "keywords": [
            "CLT",
            "Cross-laminated timber",
            "Exposed roof structure",
            "Glulam",
            "HSK connector",
            "Hybrid",
            "Overhang",
            "Steel"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": null,
          "language": "English",
          "source": "Scopus",
