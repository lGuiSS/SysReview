  "currentSection": "filter1",
  "importedData": [
    {
      "id": 1,
      "database": "Scopus",
      "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
      "articles": [
        {
          "id": "scopus_1",
          "title": "Experimental evaluation on the shear performance of grouted bolt connections in steel-CLT and steel-CLBT composite structures",
          "authors": "Lu, Jinwei and Wei, Yang and Du, Hao and Zhao, Kang and Huang, Silu and Chen, Jiawei",
          "affiliations": "Nanjing Forestry University, College of Civil Engineering, Nanjing, Jiangsu, China; Nanjing Forestry University, Nanjing, Jiangsu, China",
          "countries": [
            "China"
          ],
          "journal": "Thin-Walled Structures",
          "year": 2026,
          "score": 17,
          "abstract": "Steel-cross laminated timber (CLT) composite floors have increasingly emerged as an alternative to steel-concrete composite floors due to their sustainability and construction efficiency. In addition, given the superior mechanical properties and resource utilization of cross-laminated bamboo and timber (CLBT), steel-CLBT composite systems hold promise for further enhancing the overall structural performance of steel-timber composite (STC) floors. The composite action of STC systems is governed by the shear performance of their connections. Traditional demountable bolt connections exhibit low stiffness in STC systems. Therefore, this study proposed grouted bolt connections for steel-CLT and steel-CLBT composite structures. Ten sets of push-out specimens were designed to investigate the effects of bolt diameter, bolt strength, grout diameter, and panel type. The test results indicate that steel-CLBT connections failed due to bolt shear, whereas those in the steel-CLT connections exhibited failure modes involving grout crushing, timber crushing, and bolt bending. The grouted bolted connections in the steel-CLBT composite system exhibit significantly higher shear capacity and slip stiffness than those in the steel-CLT composite system (shear capacity increased by 45–70% and slip stiffness increased by 1.8–10 times), albeit with lower ductility. In addition, compared with demountable bolted connections, the grouted bolted connections in the steel-CLBT composite system achieve more than a twofold increase in slip stiffness. Finally, based on the different failure modes, the shear capacity and load-slip behavior of various connections were evaluated and predicted. © 2026 Elsevier Ltd",
          "keywords": [
            "Cross-laminated bamboo and timber (CLBT)",
            "Cross-laminated timber (CLT)",
            "Grouted bolt connections",
            "Shear performance",
            "Steel"
          ],
          "studyType": "Article",
          "quality": null,
          "doi": "10.1016/j.tws.2026.114573",
          "language": "English",
          "source": "Scopus",
          "numString": 2,
          "isDuplicate": false,
          "duplicateOf": null,
          "dataProcessingStatus": "pending",
          "filter1Status": "pending",
          "filter2Status": "pending",
          "filter3Status": "pending",
          "exclusionReason": null,
          "inclusionCriterion": null,
          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:36:57.979Z",
          "lastModified": "2026-02-23T22:36:57.979Z"
        },
        {
          "id": "scopus_2",
          "title": "Experimental and Theoretical Investigation on the Long-Term Behavior of Posttensioned Cross-Laminated Timber Shear Walls",
          "authors": "Sun, Xiaofeng and Li, Minghao and He, Minjuan and Zheng, Xiuzhi",
          "affiliations": "Xiamen University, School of Architecture and Civil Engineering, Xiamen, Fujian, China; The University of British Columbia, Department of Wood Science, Vancouver, BC, Canada; Tongji University, Department of Structural Engineering, Shanghai, China",
          "countries": [
            "China",
            "Canada"
          ],
          "journal": "Journal of Structural Engineering",
          "year": 2026,
          "score": 41,
          "abstract": "For posttensioned (PT) cross-laminated timber (CLT) shear walls under long-term service conditions, the posttensioning force will change over time due to a combination of CLT creep deformation and environmental deformation, with the latter specifically denoting hygroscopic shrinkage or swelling. To comprehend the long-term behavior of PT CLT shear walls in uncontrolled environments, 500-day long-term tests were conducted on seven PT CLT shear walls with varying configurations and design parameters. Additionally, one unloaded CLT wall panel and one unloaded CLT floor with the same dimensions as those being posttensioned were arranged as the control specimens to obtain the environmental strain. The existing posttensioning force, the moisture content (MC) of the specimens, the total and the environmental strain of the CLT, as well as the ambient temperature and relative humidity (RH) were measured and analyzed, considering the influencing factors including the initial compressive stress levels, the number of CLT layers, and the presence of the CLT floors subjected to out-of-plane transverse compression. Additionally, an iterative computational procedure was proposed to predict the MC variations in CLT and the long-term posttensioning losses in the PT CLT shear walls based on the finite-difference method. The computational procedure was then validated based on the 500-day long-term test results. The environmental strain in the CLT floors occurs primarily along the out-of-plane transverse direction. This strain is about 10 times greater than that in the CLT wall panels along their in-plane major strength direction. The CLT floors exhibited notably high creep coefficients over 500 days, ranging from 6.68 to 7.73. The existing posttensioning force would be higher than the initial force during a substantial portion of the monitoring period, due to the decrease in prestress applied to the CLT panels. A relatively accurate prediction of the MC variations in CLT is achieved through moisture diffusion analysis. The validated computational procedure is capable of predicting long-term posttensioning losses. © 2026 American Society of Civil Engineers.",
          "keywords": [
            "500-day long-term test",
            "Influencing factor",
            "Iterative computational procedure",
            "Posttensioned cross-laminated timber (CLT) shear wall",
            "Posttensioning loss"
          ],
          "studyType": "Article",
          "quality": null,
          "doi": "10.1061/JSENDH.STENG-15432",
          "language": "English",
          "source": "Scopus",
          "numString": 2,
