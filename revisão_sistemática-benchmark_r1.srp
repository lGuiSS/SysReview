        {
          "id": "scopus_477",
          "title": "EXPERIMENTAL ANALYSIS OF THE INFLUENCE OF OPENINGS IN THE DEFLECTION OF CROSS-LAMINATED TIMBER PLATES LOADED OUT OF PLANE",
          "authors": "González-Sern, Pablo and Yurrita, Miguel and Cabrero, J. M.",
          "affiliations": "UNAV University of Navarra, Navarra, Spain",
          "countries": [
            "Spain"
          ],
          "journal": "13th World Conference on Timber Engineering, WCTE 2023",
          "year": 2023,
          "score": 13,
          "abstract": "This paper presents a series of experimental tests that were conducted to investigate the effect of openings on the deformation of cross laminated timber (CLT) floor panels. A comparison is made between the tests results and different FE shell models and simplified beam models developed for prediction. The research aims to provide new design criteria and user-friendly models to enhance the predictability of CLT structures and increase its versatility as a building material. © 13th World Conference on Timber Engineering, WCTE 2023. All rights reserved.",
          "keywords": [
            "CLT",
            "cross-laminated timber",
            "experimental investigation",
            "floors",
            "mass timber",
