    {
      "id": "scopus_743",
      "title": "Catalyst - A mass timber core wall building with high ductility hold-downs in a seismic region",
      "authors": "Zimmerman, Reid B. and Blomgren, Hans Erik and McCutcheon, Jack and Sinha, Arijit",
      "affiliations": "KPFF Consulting Engineers Inc., Tacoma, WA, United States; Katerra, Seattle, WA, United States; Oregon State University, Corvallis, OR, United States",
      "countries": [
        "United States"
      ],
      "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
      "year": 2021,
      "score": 15,
      "abstract": "The Catalyst building in Spokane, WA, USA represents an evolution in the innovative use of mass timber walls as the lateral force-resisting system of buildings in seismic regions of the United States. It does so by introducing high ductility hold-downs in the form of buckling-restrained braces, forming core walls through vertical shear transfer between orthogonal cross-laminated timber (CLT) wall panel corners, and using CLT floor and roof diaphragms without a structural topping for seismic resistance. Since the governing building code does not prescriptively permit mass timber shear walls in seismic regions of the United States, the Catalyst project team effectually implemented performance-based design and nonlinear analysis to demonstrate the building's seismic performance. Project-specific core wall corner sub-assembly testing also supported the novel core configuration necessary to resist code-prescribed torsional seismic loading. Through close coordination between the design team and contractor, construction of the relatively few special details to realize this innovative lateral force-resisting system were performed successfully. © WCTE 2021. All rights reserved.",
      "keywords": [
        "Buckling-Restrained brace",
        "Case study",
        "Mass Timber core wall",
        "Performance-based seismic design"
      ],
      "studyType": "Conference paper",
      "quality": null,
      "doi": null,
      "language": "English",
      "source": "Scopus",
      "numString": 2,
      "isDuplicate": false,
      "duplicateOf": null,
      "dataProcessingStatus": "included",
      "filter1Status": "pending",
      "filter2Status": "pending",
      "filter3Status": "pending",
