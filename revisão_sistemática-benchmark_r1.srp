    {
      "id": "web_of_science_1920",
      "title": "2D constant-loss taper for mode conversion",
      "authors": "Horth, Alexandre and Kashyap, Raman and Quitoriano, Nathaniel J.",
      "affiliations": "McGill University; Universite de Montreal; Polytechnique Montreal; Universite de Montreal; Polytechnique Montreal; McGill University",
      "countries": [],
      "journal": "PHYSICS AND SIMULATION OF OPTOELECTRONIC DEVICES XXIII",
      "year": 2015,
      "score": 19,
      "abstract": "Proposed in this manuscript is a novel taper geometry, the constant-loss taper (CLT). This geometry is derived with 1D slabs of silicon embedded in silicon dioxide using coupled-mode theory (CMT). The efficiency of the CLT is compared to both linear and parabolic tapers using CMT and 2D finite-difference time-domain simulations. It is shown that over a short 2D, 4.45 pm long taper the CLT's mode conversion efficiency is 90\\% which is 10\\% and 18\\% more efficient than a 2D parabolic or linear taper, respectively.",
      "keywords": [
        "Silicon photonics",
        "waveguides",
        "integrated optics",
        "slab waveguide",
        "taper",
        "mode converter"
      ],
