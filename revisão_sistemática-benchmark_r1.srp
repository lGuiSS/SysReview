    {
      "id": "web_of_science_1370",
      "title": "Scaling study on the fire resistance of cross-laminated timber floors",
      "authors": "Bai, Yu and Zhang, Jin and Zhang, Xilin",
      "affiliations": "Southeast University - China; Southeast University - China",
      "countries": [
        "China"
      ],
      "journal": "JOURNAL OF BUILDING ENGINEERING",
      "year": 2024,
      "score": 60,
      "abstract": "Compared to full-scale prototype experiments in timber structures, the use of reduced scale models in fire tests significantly reduces research costs and operational difficulties, thus enhancing research efficiency. However, there has been limited research on the fire performance similarity of cross-laminated timber (CLT) components. In this study, the scaling relationships of fire resistances of CLT floors, including the similarity of out-of-plane bending performance and the similarity of fire resistance, were investigated. To assess compliance with static similarity criteria, out-of-plane bending tests were conducted on CLT floors with varying scales. Based on the similarity analysis of static loading test results, the influence of size effect on out-of-plane load-carrying capacity was analysed. Afterwards, the basic requirements for the similarity of fire resistance were studied, and the thermomechanical similarity criteria with size effect of CLT floors were derived. Fire tests designed by the proposed thermomechanical similarity criteria were performed on CLT floors with different scales. A numerical approach, including mechanical improved models with size effect and similar thermomechanical models, was developed to determine the fire response of CLT scale components and verify the thermomechanical similarity criteria. The test and numerical results demonstrated that the fire tests of CLT scale components designed using the proposed thermomechanical similarity criteria yielded similar fire resistances. Moreover, the presented results could be used as reference for the scaling fire design of CLT structures.",
      "keywords": [
        "Cross-laminated timber",
        "Fire resistance",
        "Floor",
        "Scale model",
        "Similarity"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1016/j.jobe.2024.108679",
      "language": "English",
      "source": "Web of Science",
      "numString": 3,
