        },
        {
          "id": "scopus_1097",
          "title": "Influence of orientation and number of layers on the elastic response and failure modes on CLT floors: modeling and parameter studies",
          "authors": "Franzoni, Lorenzo and Lebée, Arthur and Lyon, Florent and Forêt, Gilles",
          "affiliations": "Laboratoire Navier, UPE, Marne-la-Vallee, Ile-de-France, France; Centre Scientifique et Technique du Bâtiment (CSTB), Marne-la-Vallee, Ile-de-France, France",
          "countries": [
            "France"
          ],
          "journal": "European Journal of Wood and Wood Products",
          "year": 2016,
          "score": 10,
          "abstract": "In the present paper, the bending behavior of Cross Laminated Timber panels is investigated by means of the linear elastic exact solution from Pagano (1970, 1969). The resulting stresses are the input for a wood failure criterion, which can point out the first-crack load and the respective dominant failure mode. Heterogeneous layers are modeled as equivalent and homogeneous layers. This simplified and deterministic modeling gives results in good agreement with a reference experimental test. A comparison is made with respect to the panel’s global stiffness and failure stages within the apparent elastic stage. Finally, parameter studies are carried out, in order to quantify CLT limitations and advantages. The effect of varying properties such as the panel’s slenderness, orientation of transverse layers and number of layers for a fixed total thickness are investigated. © 2016, Springer-Verlag Berlin Heidelberg.",
          "keywords": [
            "Forestry",
            "Wood",
            "Bending behavior",
            "Deterministic modeling",
            "Elastic response",
            "Experimental test",
            "Global stiffness",
            "Homogeneous layers",
            "Number of layers",
            "Parameter studies",
            "Failure modes"
          ],
          "studyType": "Article",
          "quality": null,
          "doi": "10.1007/s00107-016-1038-x",
          "language": "English",
          "source": "Scopus",
          "numString": 2,
