        {
          "id": "scopus_2062",
          "title": "Potential of Softwood Engineered Timber With Graphene",
          "authors": "Gabriel, K. and Karunasena, Warna M. and Cherry, Rebecca",
          "affiliations": "University of Southern Queensland, School of Civil Engineering and Surveying, Toowoomba, QLD, Australia; Centre for Future Materials, University of Southern Queensland, Toowoomba, QLD, Australia",
          "countries": [
            "Australia"
          ],
          "journal": "Lecture Notes in Civil Engineering",
          "year": 2020,
          "score": 14,
          "abstract": "The use of innovative materials such as graphene could provide an opportunity for low grade timber to be further utilised in engineered timber products by increasing the mechanical performance and predictability. Finite element analysis software with first order shear deformable theory is used to investigate the bending behaviour of cross laminated timber (CLT) panels reinforced with a graphene nanoplatelet (GPLs)/epoxy composite. The effective Young’s modulus for the reinforcing layers is determined using the modified Halpin-Tsai model, and Poisson’s ratio and mass density is determined by rule of mixtures. The finite element model is verified using Shear Analogy Method, thereafter, a detailed parametric study is carried out to investigate the effect of GPL weight fraction, GPL size and shape, thickness of the nanocomposite reinforcement and CLT panel edge boundary conditions. © 2020, Springer Nature Singapore Pte Ltd.",
          "keywords": [
            "Bending",
            "Cross laminated timber",
            "Engineered timber",
            "Graphene nanoplatelets",
            "Static deflection"
          ],
