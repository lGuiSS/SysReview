        {
          "id": "scopus_758",
          "title": "Numerical simulations on the global serviceability behaviours of tall timber buildings using fem",
          "authors": "Zhang, Binsheng and Zhao, Xuan and Kilpatrick, Tony and Sandersaon, Iain A.",
          "affiliations": "Glasgow Caledonian University, Glasgow, Scotland, United Kingdom",
          "countries": [
            "United Kingdom"
          ],
          "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
          "year": 2021,
          "score": 5,
          "abstract": "This research is intended to numerically simulate global serviceability behaviours of two 30-storey tall timber buildings (Buildings A and B) using commercial finite element software SAP2000. Building A is to be constructed purely with CLT panels, while Building B is the Glulam frame building with the CLT core and floors. The first three lowest vibrational frequencies, modes and shapes, together with the static storey and global horizontal displacements are obtained and analysed. Thus, the peak accelerations of the buildings due to wind load can be determined and assessed against the ISO standard. A parameter study is also conducted on assessing the peak accelerations of both buildings by varying timber material properties. Both tall timber buildings are assumed to be located in Glasgow, Scotland, UK. © WCTE 2021. All rights reserved.",
          "keywords": [
            "CLT",
            "Glulam",
            "Horizontal displacement",
            "Peak acceleration",
            "Tall timber building",
            "Wind load"
          ],
