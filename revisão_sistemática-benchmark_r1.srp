    {
      "id": "scopus_733",
      "title": "Humidity exchange between CLT and UHPC slab in early age period",
      "authors": "Nguyen, Truong Thanh and Sorelli, Luca G. and Wang, Xiaodong",
      "affiliations": "Université Laval, Quebec, QC, Canada",
      "countries": [
        "Canada"
      ],
      "journal": "World Conference on Timber Engineering 2021, WCTE 2021",
      "year": 2021,
      "score": 39,
      "abstract": "A plastic insulation layer is used in timber-concrete composite (TCC) floors for preventing humidity exchange between timber and concrete However, the presence of this layer may affect the bond between the two materials and the ability to fill notch-type connectors with a negative effect on connection stiffness (K) and shear strength (VH). This issue is more critical for shallow notch connection in CLT slab. Furthermore, the plastic layer increases assembly time and represents a high indirect cost. As modern ultra-high performance concretes have less water content, this study aims at investigating the water exchange between cross-laminated timber (CLT) and fresh cast-in-place concrete for three classes of concretes: Normal concrete (NC), High-performance concrete (HPC), and Ultra-High-Performance Fiber-Reinforced Concrete (UHPFRC). Besides, different timber's humidity levels were investigated experimentally, and a simplified analytical model was developed for estimating the water amount in exchange for each test combination. The consequences of humidity change in material property were also evaluated. Based on the presented results, possible enhancements of current construction practice for TCC structures are recommended. © WCTE 2021. All rights reserved.",
      "keywords": [
        "CLT",
        "Fresh concrete",
        "Moisture content",
        "Timber humidity change",
        "Timber-concrete composite structure"
      ],
      "studyType": "Conference paper",
      "quality": null,
      "doi": null,
