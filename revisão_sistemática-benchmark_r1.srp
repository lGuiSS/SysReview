    {
      "id": "web_of_science_1724",
      "title": "Full-Scale Shake Table Testing of Cross-Laminated Timber Rocking Shear Walls with Replaceable Components",
      "authors": "Blomgren, Hans-Erik and Pei, Shiling and Jin, Zhibin and Powers, Josh and Dolan, James D. and van de Lindt, John W. and Barbosa, Andre R. and Huan, D.",
      "affiliations": "Colorado School of Mines; Southwest Jiaotong University; Washington State University; Colorado State University System; Colorado State University Fort Collins; Oregon State University",
