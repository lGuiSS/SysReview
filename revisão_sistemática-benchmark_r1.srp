        {
          "id": "web_of_science_1678",
          "title": "Experimental characterization of a biaxial behaviour connector for CLT wall-to-floor connections under different load directions",
          "authors": "D'Arenzo, Giuseppe and Seim, Werner and Fossetti, Marinella",
          "affiliations": "Universitat Kassel; Universita Kore di ENNA",
          "countries": [],
          "journal": "CONSTRUCTION AND BUILDING MATERIALS",
          "year": 2021,
          "score": 13,
          "abstract": "This paper presents an experimental study aimed at characterizing the mechanical behaviour of a new shear-tension connector for wall-to-floor connections of CLT structures. The shear-tension behaviour is reached by means of fully threaded screws inserted in the floor joint. Experimental tension, shear and inclined load tests are performed to investigate the biaxial behaviour of the connector. Results of such tests, performed in monotonic and cyclic regime, were used for the definition of force, displacement, stiffness and ductility domains. Circular experimental domains were found for all the mechanical parameters, confirming the biaxial mechanical behaviour of the connection. (c) 2021 Elsevier Ltd. All rights reserved.",
          "keywords": [
            "Cross-laminated timber",
            "Connection test",
            "Angle bracket",
            "Coupled behaviour",
            "Strength domain",
            "Displacement domain"
          ],
          "studyType": "Article",
