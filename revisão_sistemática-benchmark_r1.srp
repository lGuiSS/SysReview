        {
          "id": "web_of_science_1399",
          "title": "Experimental dataset for effective bending stiffness and load-carrying capacity of CLT-concrete composite floor systems",
          "authors": "Shahnewaz, Md and Jackson, Robert and Tannert, Thomas",
          "affiliations": "University of Northern British Columbia",
          "countries": [],
          "journal": "DATA IN BRIEF",
          "year": 2025,
          "score": 18,
          "abstract": "This article presents the dataset from experimental investigations on cross-laminated timber (CLT) concrete composite (TCC) floor systems. The data was collected at the University design decisions for ``Limberlost Place''",
