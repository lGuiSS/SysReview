          "lastModified": "2026-02-23T22:36:57.986Z"
        },
        {
          "id": "scopus_22",
          "title": "Experimental study on progressive collapse resistance of CLT wall-floor systems",
          "authors": "Ding, Yujian and Zhang, Jin and Zhu, Jiaheng and Jiang, Mengqi",
          "affiliations": "Key Laboratory of Concrete and Prestressed Concrete Structures, Ministry of Education, Nanjing, Jiangsu, China; Tongji University, Shanghai, China; JD.com, Inc., Beijing, China",
          "countries": [
            "China"
          ],
          "journal": "Construction and Building Materials",
          "year": 2025,
          "score": 26,
          "abstract": "With the rapid development of multi-story mass timber buildings, Cross-Laminated Timber (CLT) has been widely applied. The collapse resistance of CLT structures has become a key issue affecting their safe application. Existing research has mainly focused on theoretical analysis and numerical simulations, with limited experimental validation of the failure mechanisms and performance of CLT structures under collapse scenarios. This study systematically investigates the impact of screw length, framing angle specifications, and floor-to-floor connection (continuous, Half-lap, and bonded rebar) on the system's load-bearing performance and failure mechanisms through five full-scale vertical loading tests (referred to as pushdown test in this paper). The experimental results reveal two primary failure modes: continuous floor-to-floor connection specimens exhibit a",
          "keywords": [
            "Connector details",
            "Cross-Laminated Timber (CLT)",
            "Floor-to-Floor connection",
            "Progressive collapse",
            "Vertical loading tests"
          ],
          "studyType": "Article",
          "quality": null,
          "doi": "10.1016/j.conbuildmat.2025.144678",
          "language": "English",
          "source": "Scopus",
          "numString": 2,
