        },
        {
          "id": "scopus_1159",
          "title": "Structural behaviour of point-supported CLT floor systems",
          "authors": "Popovski, Marjan and Chen, Zhiyong and Gafner, Bernhard",
          "affiliations": "FPInnovations, Canada, Pointe-Claire, QC, Canada; The University of British Columbia, Department of Wood Science, Vancouver, BC, Canada; Fast + Epp Structural Engineers, Vancouver, BC, Canada",
          "countries": [
            "Canada"
          ],
          "journal": "WCTE 2016 - World Conference on Timber Engineering",
          "year": 2016,
          "score": 25,
          "abstract": "This paper presents an experimental investigation of the structural behaviour and dynamic characteristics of an innovative, double-span, point-supported Cross Laminated Timber (CLT) floor system for an 18-stroey woodhybrid student residence building at the University of British Columbia Campus in Vancouver, Canada. Eighteen CLT floor specimens with or without service openings were fabricated by three manufacturers and tested. The fundamental natural frequency, stiffness and deformability, load-carrying capacity, two-way action, compression perpendicular to grain at the supports, and the failure mechanism of the floor systems were investigated. In addition, the effect of openings in the floors was investigated along with the manufacturer-related properties of the CLT floors were examined. The tests gave an insight into the structural behaviour of this innovative floor system, provided test data that was used for calibration of the Finite Element Models of the building, and helped choose the right product for the floors.",
          "keywords": [
            "CLT floors",
            "Floor dynamic characteristics",
            "Floors with openings",
            "Point-supported floors",
            "Tall wood buildings",
            "Two-way floor action"
