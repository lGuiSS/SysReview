          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:37:03.807Z",
          "lastModified": "2026-02-23T22:37:03.807Z"
        },
        {
          "id": "web_of_science_1312",
          "title": "Seismic Performance and Kinematic Behavior of Multistory Cutout CLT Shear Walls",
          "authors": "Mestar, Mohammed and Mori, Takuro and Nakashima, Shoichi and Yamagata, Kaito",
          "affiliations": "Hiroshima University",
          "countries": [],
          "journal": "JOURNAL OF STRUCTURAL ENGINEERING",
          "year": 2025,
          "score": 28,
          "abstract": "The present experimental study aims to analyze the behavior of multistory cross-laminated timber (CLT) shear walls with cut openings, considering realistic configurations commonly encountered in CLT buildings. In addition, this study investigates the influence of floor elements on CLT shear wall performance. Experimental results demonstrated a 40\\% increase in load-bearing capacity compared with floorless configurations, attributed to floor-induced lintel beam stiffening that promotes near-rigid behavior and fastener mobilization. Quantitative improvements included 36\\% greater ultimate ductility, 8\\% enhanced system ductility, and 30\\% increased energy-dissipation capacity through floor-wall friction. Findings revealed that conventional segmented analysis methods significantly underestimate walls with cutout-produced lintels. Two-story specimens exhibited consistent triangular displacement distribution across all loading phases, with equivalent interstory ductility confirming deformation dominated by base rotation, aligning with seismic rocking principles. Floor integration eliminated base compression, increasing rotational capacity while engaging ground-level bolts. Second-story behavior transitioned to single-center-of-rotation kinematics, indicating enhanced stability. The floor's restraint effect reduced lintel cracking while promoting controlled bolt failure, concentrating damage in replaceable connections and demonstrating high system reparability.",
          "keywords": [
            "Multistory cross-laminated timber (CLT) shear walls",
            "Cutout cross-laminated timber (CLT) panels",
            "Full-scale tests",
            "Cyclic tests",
            "Floor effect",
            "Kinematic modes",
            "Seismic performance of cross-laminated timber (CLT) shear walls",
            "Wood structures"
          ],
