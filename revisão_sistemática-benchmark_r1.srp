        },
        {
          "id": "scopus_995",
          "title": "Self-tensioning long-span T-shaped spruce and oak web floors with a CLT upper flange. An experimental approach",
          "authors": "Martín-Gutiérrez, Emilio and Estévez-Cimadevila, Javier and Otero-Chans, Dolores and Suárez-Riestra, Félix",
          "affiliations": "Universidade da Coruña, Civil and Aeronautical Buildings and Structures, A Coruna, A Coruña, Spain",
          "countries": [
            "Spain"
          ],
