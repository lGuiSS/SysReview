    {
      "id": "scopus_1026",
      "title": "Fire resistance of unprotected cross-laminated timber wall and floor assemblies made in the USA",
      "authors": "Muszyñski, Lech and Gupta, Rakesh and Hong, Seung-hyun and Osborn, Neil and Pickett, Brent",
