        {
          "id": "scopus_430",
          "title": "Design of geometric variables of hold-down and angle bracket connections for lateral resistance enhancement of cross-laminated timber (CLT) walls considering the influence of wood species, load-grain angles, and floor conditions",
          "authors": "Khai Tran, Dang and Jeong, Gi-young",
          "affiliations": "Vietnam Aviation Academy, Department of Civil Engineering, Ho Chi Minh City, Viet Nam; Chonnam National University, Department of Wood Science and Engineering, Gwangju, South Korea",
          "countries": [
            "Vietnam",
