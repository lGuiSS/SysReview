    {
      "id": "scopus_497",
      "title": "BENDING CHARACTERISTICS OF CLT FROM RECOVERED SPRUCE",
      "authors": "Uí Chúláin, Caitríona and Llana, Daniel F. and Hogan, Paul and McGetrick, Patrick John and Harte, Annette M.",
      "affiliations": "University of Galway, Galway, Connacht, Ireland; Universidad Politécnica de Madrid, Madrid, Madrid, Spain; Hegarty Demolition, Ireland; University of Galway, Galway, Connacht, Ireland",
      "countries": [
        "Ireland",
        "Spain"
      ],
      "journal": "13th World Conference on Timber Engineering, WCTE 2023",
      "year": 2023,
      "score": 29,
      "abstract": "The circular use of construction materials is an essential step in the drive to reduce the environmental impact of the construction sector. Structural materials, such as timber, recovered from demolition of buildings is a valuable resource. Reuse or recycling these materials in new buildings products reduces waste and the overall carbon footprint of the build environment. This paper investigates the use of spruce recovered from demolition of a roof structure in the manufacture of CLT panels. Bending tests are performed on 3-layer panels made from this recovered material and also on panels made from new timber and hybrid panels with mixed new and recovered timber. Results show that the performance of CLT panels using recovered timber is equivalent to that of panels from new timber in terms of bending strength and stiffness. © (2023) WORLD CONFERENCE ON TIMBER ENGINEERING 2023 (WCTE 2023) All rights reserved.",
      "keywords": [
        "circular construction",
        "Douglas fir",
        "mass timber",
        "reclaimed",
        "recovered timber",
        "salvaged",
        "secondary timber",
        "spruce"
      ],
