          "exclusionCriterion": null,
          "extractionCriteria": null,
          "searchString": "(( \"cross laminated timber\" OR \"cross-laminated timber\" OR “x-lam” OR CLT) AND ( slab OR floor OR roof ))",
          "importDate": "2026-02-23T22:36:58.150Z",
          "lastModified": "2026-02-23T22:36:58.150Z"
        },
        {
          "id": "scopus_1084",
          "title": "Rationalization of cross-laminated timber design standards",
          "authors": "Craft, Steven T. and van Zeeland, Ineke M.",
          "affiliations": "CHM Fire Consultants Ltd., Ottawa, ON, Canada; Canadian Wood Council, Ottawa, ON, Canada",
          "countries": [
            "Canada"
          ],
          "journal": "15th International Conference and Exhibition on Fire and Materials 2017",
          "year": 2017,
          "score": 13,
          "abstract": "With increased interest in building larger and taller timber buildings, the use of timber panel products such as cross-laminated timber (CLT), laminated veneer lumber (LVL), and nail-laminated timber (NLT) have seen an increase in use. Standard fire-resistance tests conducted on CLT panels have demonstrated the wall and floor assemblies can provide excellent fire resistance when either left exposed or, increasingly so, when protected by gypsum board. In the last few years, the design standards in the US (NDS) and Canada (CSA O86-14) have both added design criteria for CLT. In addition to the regular design provisions for structural design, the standards have included informative design criteria for standard structural fire resistance. This paper provides some of the background rationale for the design methodology and provisions and compares standard fire-resistance test results with predictions of standard fire-resistance times using the design standards. Excellent agreement is shown between the test results and the fire-resistance times calculated in accordance with the design standards.",
          "keywords": [
            "Laminating",
            "Standards",
            "Structural design",
            "Timber",
            "Wooden buildings",
            "Cross laminated",
            "Design Methodology",
            "Design standard",
            "Laminated timber",
            "Laminated veneer lumber",
            "Regular designs",
            "Structural fires",
            "Timber buildings",
            "Fire resistance"
          ],
          "studyType": "Conference paper",
