    {
      "id": "scopus_53",
      "title": "Structural performance of self-tapping screws for use in steel-CLT composite members",
      "authors": "Merryday, Hugh C. and Sener, Kadir C. and Roueche, David B.",
      "affiliations": "Samuel Ginn College of Engineering, Advanced Structural Engineering Laboratory, Auburn, AL, United States",
      "countries": [
        "United States"
      ],
      "journal": "Engineering Structures",
      "year": 2025,
      "score": 48,
      "abstract": "Steel-timber floor systems are gaining popularity as an alternative structural system to meet the growing demands to incorporate more sustainable building materials into the construction market. This paper presents an experimental investigation to evaluate the performance of self-tapping screws (STS) as a connection element in steel-timber composite (STC) construction. Symmetric monotonic push-out tests were conducted on cross-laminated timber (CLT) manufactured with southern yellow pine species fastened to hot-rolled wide flange steel sections using three different types of STS available in the US construction market. Experimental results revealed that screw ductility at the steel-CLT shear interface is critical for plastic hinged development, hindering the connection's ability to reach peak capacities. Other conclusions suggest that: 1) connection strength and stiffness is not highly sensitive to the load orientation with respect to the grain layup in CLT, permitting equivalent designs in the major and minor strength directions, 2) reducing screw spacings below 12D can cause strength and stiffness reduction parallel to the major CLT axis, and 3) an upper bound embedment length of about 12D into the CLT is observed to maximize strength while maintaining connection ductility. Existing connection design equations in the European and US timber design standards excessively underestimate the screw strength due to neglecting the substantial strength contribution from screw withdrawal. Therefore, to improve the design efficiency of STC connections utilizing STS, a previously proposed calculation model is extended to the connections of this study and validated for specimens with ductile failures. © 2025 Elsevier Ltd",
      "keywords": [
        "Composite floor systems",
        "Cross laminated timber",
        "Fastener stiffness",
        "Fastener strength",
        "Mechanical fastener behavior",
        "Pushout testing",
        "Self-tapping screws",
        "Steel member",
        "Steel-timber",
        "Structural systems"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1016/j.engstruct.2025.120652",
      "language": "English",
      "source": "Scopus",
      "numString": 2,
