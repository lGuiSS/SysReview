    {
      "id": "scopus_12",
      "title": "Design exploration of robotically assembled cross-laminated timber houses with sequential path planning",
      "authors": "Zargar, Seyed Hossein and Duarte, Jose Pinto Pinto and Brown, Nathan Collin",
      "affiliations": "Penn State College of Engineering, University Park, PA, United States; Pennsylvania State University, Department of Architecture, University Park, PA, United States",
      "countries": [
        "United States"
      ],
      "journal": "Automation in Construction",
      "year": 2026,
      "score": 16,
      "abstract": "Robotic construction technologies, which require computational coordination, offer new opportunities to develop quantitative assessments of constructability for early design exploration. This paper demonstrates an approach to extracting simplified constructability metrics during sequential path planning for building construction with a mobile robotic arm. The approach is used to explore a design space for a Cross-Laminated Timber (CLT) panel house. Constructability is assessed through robot travel time, robot viability ratings, assembly steps requiring temporary shoring, and panel waste. The robot viability ratings are created by predefining wall and roof panel assembly scenarios, which are assigned difficulty weights using full path planning simulations. Sequential path planning and stability analyses are then conducted to count the weighted scenarios and instances requiring temporary supports for the design. The scenario counts in the assembly sequences are then aggregated into overall viability ratings for each design, enabling comparative assessments across the design space. © 2025 Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.",
      "keywords": [
        "Data-driven design",
        "Design space exploration",
        "Human-robot collaborative construction",
        "Multi-objective optimization",
        "Robotic constructability assessment"
      ],
      "studyType": "Article",
      "quality": null,
      "doi": "10.1016/j.autcon.2025.106637",
      "language": "English",
