    {
      "id": "scopus_1040",
      "title": "Butt joint gluing of cross laminated timber",
      "authors": "Themessl, Adam and Lehmann, Martin and Salzgeber, Dario and Franke, Steffen",
      "affiliations": "BFH, Biel, Switzerland; Henkel & Cie. AG, Switzerland",
      "countries": [
        "Switzerland"
      ],
      "journal": "WCTE 2018 - World Conference on Timber Engineering",
      "year": 2018,
      "score": 20,
      "abstract": "Timber Structures 3.0 - a Swiss timber engineering company - shows a new way to join Cross Laminated Timber elements by bonding without contact pressure. The edge surfaces of the elements are pre-treated and joined on site by using a pneumatically driven adhesive applicator. This system allows point-supported slabs for industrial buildings with a support grid of up to 8 m × 8 m and live loads of 5 kN/m <sup>2</sup> . Seven years of research on the adhesive line now show results of flawless bonding with mean rupture strength in tensile direction of 18.6 N/mm <sup>2</sup> . Further research is done to improve rupture behaviour and on-site construction processes. © WCTE 2018 Committee.",
      "keywords": [
        "Butt joint bonding",
        "Cross Laminated Timber",
        "Industrial timber construction"
      ],
