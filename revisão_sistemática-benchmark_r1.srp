    {
      "id": "scopus_1213",
      "title": "Experimental investigation of bending behavior of timber-to-timber composite-section beams",
      "authors": "Salem, Osama (Sam)",
      "affiliations": "Lakehead University, Department of Civil Engineering, Thunder Bay, ON, Canada",
      "countries": [
        "Canada"
      ],
      "journal": "WCTE 2014 - World Conference on Timber Engineering, Proceedings",
      "year": 2014,
      "score": 45,
      "abstract": "Wood has long been in demand as a competent building material due to its beauty, economy, and ease of construction. Excellent material properties are exhibited by a number of new engineered wood products such as gluedlaminated (Glulam) and cross-laminated timbers (CLT). New experimental data on the structural behaviour of CLT-to-Glulam composite-section beams is presented in this paper. Four large-scale test assemblies composed of two different engineered wood sections were tested. Beam composite sections were built of a top flange part made of a cross-laminated timber slab and a web part made of a Glulam rectangular section. The two parts forming each beam section were connected together using 5/16? self-tapping screws in order to create composite action. Results from this research showed that reducing the spacing distance between screws considerably increased the flexural stiffness of the CLT-to-Glulam composite beams.",
      "keywords": [
        "Composite-section beams",
        "Cross-laminated timber",
        "Engineered wood products",
        "Flexural stiffness",
        "Glued-laminated timber",
        "Structural performance"
      ],
      "studyType": "Conference paper",
      "quality": null,
      "doi": null,
      "language": "English",
      "source": "Scopus",
      "numString": 2,
