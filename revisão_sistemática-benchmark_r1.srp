        {
          "id": "scopus_589",
          "title": "A comprehensive vibroacoustic investigation of a cross laminated timber floor",
          "authors": "Caniato, Marco and Bettarello, Federica and Granzotto, Nicola and Marzi, Arianna and Gasparella, Andrea",
          "affiliations": "Free University of Bozen-Bolzano, Faculty of Science and Technology, Bolzano, BZ, Italy; Università degli Studi di Trieste, Department of Engineering and Architecture, Trieste, TS, Italy",
          "countries": [
            "Italy"
          ],
          "journal": "Construction and Building Materials",
          "year": 2022,
          "score": 8,
          "abstract": "In recent years, the use of sustainable construction materials has increased significantly. It is of paramount importance to increase the general knowledge of acoustic behaviour of these materials. This research presents the results of a comprehensive acoustic investigation of a 200 mm timber slab. Excitations using different acoustic sources are performed. The results to this investigation are reported in this paper, focusing on the sound reduction index, impact noise reduction, static and frequency-dependant Young's modulus, vibration and modal mapping and radiation efficiency. Finally, a correlation between impact noise levels caused by the tapping machine and the rubber ball is provided. © 2022 Elsevier Ltd",
          "keywords": [
            "Acoustic noise",
            "Acoustics",
            "Elastic moduli",
            "Timber",
