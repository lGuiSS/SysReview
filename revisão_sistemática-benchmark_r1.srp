    {
      "id": "web_of_science_2176",
      "title": "3D FEA modelling of laminated composites in bending and their failure mechanisms",
      "authors": "Meng, M. and Le, H. R. and Rizvi, M. J. and Grove, S. M.",
      "affiliations": "University of Plymouth",
      "countries": [],
      "journal": "COMPOSITE STRUCTURES",
      "year": 2015,
      "score": 30,
      "abstract": "This paper developed three-dimensional (3D) Finite Element Analysis (FEA) to investigate the effect of fibre lay-up on the initiation of failure of laminated composites in bending. Tsai-Hill failure criterion was applied to identify the critical areas of failure in composite laminates. In accordance with the 3D FEA, unidirectional ([",
