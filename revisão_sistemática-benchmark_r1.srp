    {
      "id": "scopus_1152",
      "title": "Mechanical properties of a composite lamella built up with thin sideboards and its utilization to increase the material efficiency of structural elements",
      "authors": "Sieder, Raimund and Augustin, Manfred and Lierzer, Thomas",
      "affiliations": "holz.bau forschungs gmbh, Graz, Styria, Austria; Mayr-Melnhof Holz Holding AG, Leoben, Austria",
      "countries": [
        "Austria"
      ],
      "journal": "WCTE 2016 - World Conference on Timber Engineering",
      "year": 2016,
      "score": 19,
      "abstract": "To increase the material efficiency of Cross Laminated Timber (CLT) a composite lamella was investigated. The lamella with a hollow cross section was built up with spruce sideboards. The hollow-lamellas (HL) have high mechanical properties. Two different types of structural elements were produced with HL. First results showed that despite a reduction of material between 13 % and 17 % the investigated slabs had a similar strength and stiffness compared with conventional CLT elements produced with C24 acc. to EN 338.",
      "keywords": [
        "CLT",
        "Creep",
        "Hollow-lamella",
