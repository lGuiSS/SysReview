        {
          "id": "scopus_1229",
          "title": "Seismic retrofit of soft-story woodframe buildings using cross laminated timber",
          "authors": "van de Lindt, John W. and Bahmani, Pouria and Gershfeld, Mikhail and Kandukuri, Giraj Kumar and Rammer, Douglas R. and Pei, Shiling",
          "affiliations": "Walter Scott, Jr. College of Engineering, Fort Collins, CO, United States; California State Polytechnic University, Pomona, Department of Civil & Environmental Engineering, Pomona, CA, United States; The University of Alabama, Tuscaloosa, AL, United States; U.S. Forest Products Laboratory, Madison, NC, United States; Jerome J. Lohr College of Engineering, Brookings, SD, United States",
          "countries": [
            "United States"
          ],
