        {
          "id": "scopus_1025",
          "title": "Performance of hybrid cross laminated timber - Concrete composite floor",
          "authors": "Khai, Mai Quang and Lee, Kihak",
          "affiliations": "Sejong University, Seoul, South Korea",
          "countries": [
            "South Korea"
          ],
          "journal": "WCTE 2018 - World Conference on Timber Engineering",
          "year": 2018,
          "score": 25,
          "abstract": "The hybrid Cross-Laminated Timber (CLT) and concrete system has drawn attention as an attractive application for residential and non-residential buildings. It is important to fully understand the mechanical performances of the CLT-concrete composite system before such a hybrid structure becomes widely applicable. This paper assesses the structural behaviour (force-slip response, slip modulus, and failure modes) of the CLT-concrete composite by conducting nine push-out test specimens and five composite floor specimens which were designed by using y-method (Eurocode 5). In these composite specimens, CLT floor panels are connected to concrete slabs by using common mechanical connectors, and effect of different connection types, connection angles of connection, and concrete thickness are investigated. Nonlinear 3D finite element models have been also developed to simulate the load-slip response of CLT-concrete specimens under shear load. © WCTE 2018 Committee.",
          "keywords": [
            "Ansys Workbench",
            "CLT - concrete composite",
            "Cross laminated timber (CLT)",
            "Hybrid timber structure",
            "Push-out test"
          ],
