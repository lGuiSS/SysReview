        {
          "id": "scopus_518",
          "title": "EXPERIMENTAL AND NUMERICAL ANALYSIS OF CLT FLOOR SUBASSEMBLIES UNDER CATENARY ACTION",
          "authors": "Przystup, Alicja C. and Tannert, Thomas and Lu, Yong and Reynolds, Thomas P.S.",
          "affiliations": "The University of Edinburgh, Edinburgh, Scotland, United Kingdom; University of Northern British Columbia, Prince George, BC, Canada",
          "countries": [
            "United Kingdom",
            "Canada"
          ],
          "journal": "13th World Conference on Timber Engineering, WCTE 2023",
          "year": 2023,
          "score": 20,
          "abstract": "Behaviour under combined axial tension and out-of-plane bending, typically observed in catenary action after loss of a support, was investigated on Cross Laminated Timber (CLT) floors. Uni-axial tension tests as well as combined tension and bending tests on CLT component and floor subassembly levels with screw butt joints and varying boundary conditions were performed. Bending moment capacity was shown to decrease with increasing of horizontal tension on the connection. Combined loading failure envelope was developed to observe a correlation between the test results of different scale, showing the potential of using component tests as predictors of the behaviour of more complex subassemblies. © 2023 13th World Conference on Timber Engineering, WCTE 2023. All rights reserved.",
          "keywords": [
            "catenary action",
            "combined loading",
            "disproportionate collapse",
            "progressive collapse",
            "Robustness"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": "10.52202/069179-0042",
