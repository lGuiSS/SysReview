        {
          "id": "scopus_877",
          "title": "Experimental study on self-centering cross-laminated timber shear wall-floor diaphragm sub-assembly",
          "authors": "Amer, Alia and Sause, Richard S. and Ricles, James M.",
          "affiliations": "Lehigh University, Bethlehem, PA, United States",
          "countries": [
            "United States"
          ],
          "journal": "International Conference on Advances in Experimental Structural Engineering",
          "year": 2020,
          "score": 29,
          "abstract": "Conventional cross-laminated timber (CLT) construction can deliver collapse prevention performance but with the potential for significant damage during large earthquakes. A seismically resilient structural system for wood buildings can be achieved using self-centering (SC) rocking post-tensioned CLT structural walls (SC-CLT walls). Previous experimental research focused only on unidirectional testing of SC-CLT walls in isolation without considering their interaction with adjacent structural components, such as the floor diaphragm and gravity load system. These components need to accommodate the rocking motion of SC-CLT walls. A series of 0.625-scale tests were performed at the NHERI@Lehigh Experimental Facility to investigate the behavior of SC-CLT walls and their interaction with glulam collector beams, CLT floor diaphragm and glulam gravity load system under bidirectional loading. The test matrix, setup, and multidirectional displacement control algorithm are presented. The test results are then presented, including the SC-CLT wall damage states associated with prescribed story drift, wall base shear-drift hysteretic response and glulam gravity load system response under bidirectional loading. Finally, these results are compared to results from unidirectional loading tests to assess the effects of bidirectional loading on hysteretic response and resiliency of wood subassemblies. © 2020 EUCENTRE. All rights reserved.",
          "keywords": [
            "Cross-laminated timber",
            "Glulam gravity load system",
            "Multi-directional",
            "Resilience",
            "Self-Centering"
          ],
          "studyType": "Conference paper",
          "quality": null,
          "doi": null,
          "language": "English",
          "source": "Scopus",
          "numString": 2,
          "isDuplicate": false,
          "duplicateOf": null,
          "dataProcessingStatus": "pending",
