        {
          "id": "scopus_177",
          "title": "DETERMINATION OF THE RACKING STRENGTH AND STIFFNESS OF CLT PANELS MANUFACTURED FROM C16-GRADE IRISH TIMBER",
          "authors": "Kashyap, Rimjhim and O’Ceallaigh, Conan and McGetrick, Patrick John and Harte, Annette M.",
          "affiliations": "University of Galway, Timber Engineering Research Group, Galway, Connacht, Ireland; Atlantic Technological University, Department of Building and Civil Engineering, Killybegs, Donegal, Ireland",
          "countries": [
            "Ireland"
          ],
          "journal": "Proceedings from the 14th World Conference on Timber Engineering: Advancing Timber for the Future Built Environment, WCTE 2025",
          "year": 2025,
          "score": 23,
          "abstract": "This study examines the racking strength and stiffness of CLT panels manufactured from C16-grade timber using Irish Sitka spruce. The timber obtained from Sitka spruce in Ireland is typically graded as C16. In Europe, CLT is primarily manufactured with C24-grade timber, and most of the research available on the structural behaviour of CLT is presented for C24-grade material only. In this study, C16 grade material is examined by subjecting full-scale CLT panels manufactured using C16-grade CLT to racking resistance tests. The CLT wall panels are connected to CLT floor panels using only angle brackets and screws. A preliminary investigation has been conducted to verify the feasibility of a non-standard application of angle bracket connectors for the design of a multi-storey modular building using CLT made from C16-grade Irish timber. © (2025) WORLD CONFERENCE ON TIMBER ENGINEERING 2025 (WCTE 2025) All rights reserved.",
          "keywords": [
            "C16-grade Irish timber",
            "CLT connections",
            "Cross-laminated timber",
            "Racking resistance"
          ],
          "studyType": "Conference paper",
          "quality": null,
